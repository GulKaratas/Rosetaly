@model List<Rentaly.EntityLayer.Entities.Car>

@{
    ViewData["Title"] = "CarList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Araçlar", "Filodaki tüm araçların anlık durum ve envanter listesi", "Araçlar", "/Admin/Car/CreateCar/", "Yeni Araç Ekle", false, ""))
}

<div class="card bg-surface-container-lowest rounded-xl shadow-sm flex flex-col overflow-hidden">
    <!-- Card Header: Search & Multi-Filters Toolbar -->
    <div class="p-space-md bg-surface-container-lowest flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-gutter-sm">
        <!-- Live Quick Search -->
        <div class="relative flex-1 min-w-[260px]">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input class="w-full pl-9 pr-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface placeholder:text-outline outline-none focus:bg-surface-container transition-colors" placeholder="Plaka, Marka veya Model ara..." type="text">
        </div>
        <!-- Filter Dropdown Selectors -->
        <div class="flex items-center flex-wrap gap-space-xs">
            <!-- Marka Filtresi -->
            <select class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Markalar</option>
                <option value="renault">Renault</option>
                <option value="volkswagen">Volkswagen</option>
                <option value="peugeot">Peugeot</option>
                <option value="bmw">BMW</option>
                <option value="ford">Ford</option>
                <option value="tesla">Tesla</option>
            </select>
            <!-- Kategori Filtresi -->
            <select class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Kategoriler</option>
                <option value="ekonomi">Ekonomi</option>
                <option value="konfor">Konfor</option>
                <option value="suv">SUV &amp; Crossover</option>
                <option value="luks">Lüks &amp; Premium</option>
                <option value="ticari">Ticari / Minivan</option>
                <option value="elektrikli">Elektrikli</option>
            </select>
            <!-- Şube Filtresi -->
            <select class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Şubeler</option>
                <option value="kadikoy">İstanbul - Kadıköy</option>
                <option value="havalimani">İstanbul - Havalimanı</option>
                <option value="levent">İstanbul - Levent</option>
                <option value="cankaya">Ankara - Çankaya</option>
                <option value="adnanmenderes">İzmir - Adnan Menderes</option>
                <option value="nilufer">Bursa - Nilüfer</option>
            </select>
            <!-- Durum Filtresi -->
            <select class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Durumlar</option>
                <option value="musait">Müsait</option>
                <option value="kirada">Kirada</option>
                <option value="rezerve">Rezerve</option>
                <option value="bakimda">Bakımda</option>
            </select>
