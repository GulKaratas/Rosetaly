@model List<Car>
@{
    ViewData["Title"] = "CarList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var brands = Model.Select(x => x.CarModel.Brand.BrandName).Distinct().OrderBy(x => x).ToList();
    var categories = Model.Select(x => x.Category.CategoryName).Distinct().OrderBy(x => x).ToList();
    var branches = Model.Select(x => x.Branch.BranchName).Distinct().OrderBy(x => x).ToList();
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Araçlar", "Filodaki tüm araçların anlık durum ve envanter listesi", "Araçlar", "/Admin/Car/CreateCar/", "Yeni Araç Ekle", false, ""))
}

<div class="card bg-surface-container-lowest rounded-xl shadow-sm flex flex-col overflow-hidden">
    <div class="p-space-md bg-surface-container-lowest flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-gutter-sm">
        <div class="relative flex-1 min-w-[260px]">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input id="carSearch" class="w-full pl-9 pr-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface placeholder:text-outline outline-none focus:bg-surface-container transition-colors" placeholder="Plaka, marka veya model ara..." type="text">
        </div>
        <div class="flex items-center flex-wrap gap-space-xs">
            <select id="brandFilter" class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Markalar</option>
                @foreach (var brand in brands)
                {
                    <option value="@brand">@brand</option>
                }
            </select>
            <select id="categoryFilter" class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Kategoriler</option>
                @foreach (var category in categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
            <select id="branchFilter" class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Şubeler</option>
                @foreach (var branch in branches)
                {
                    <option value="@branch">@branch</option>
                }
            </select>
            <select id="statusFilter" class="px-space-md py-space-xs bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface font-medium outline-none focus:bg-surface-container transition-colors cursor-pointer">
                <option value="">Tüm Durumlar</option>
                <option value="musait">Müsait</option>
                <option value="kirada">Kiralamada</option>
                <option value="pasif">Pasif</option>
            </select>
        </div>
    </div>

    <div class="w-full overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low text-secondary uppercase font-table-header text-table-header">
                    <th class="py-3 px-3" scope="col">Araç</th>
                    <th class="py-3 px-3" scope="col">Plaka</th>
                    <th class="py-3 px-3" scope="col">Marka / Model</th>
                    <th class="py-3 px-3" scope="col">Kategori</th>
                    <th class="py-3 px-3" scope="col">Şube</th>
                    <th class="py-3 px-3" scope="col">Günlük Fiyat</th>
                    <th class="py-3 px-3" scope="col">Durum</th>
                    <th class="py-3 px-3 text-right" scope="col">İşlemler</th>
                </tr>
            </thead>
            <tbody id="carTableBody" class="divide-y-0 text-on-surface font-table-cell text-table-cell">
                @foreach (var item in Model)
                {
                    var brandName = item.CarModel.Brand.BrandName;
                    var modelName = item.CarModel.ModelName;
                    var status = !item.IsActive ? "pasif" : item.IsAvailable ? "musait" : "kirada";

                    <tr class="car-row hover:bg-surface-container-low/60 transition-colors"
                        data-search="@($"{item.PlateNumber} {brandName} {modelName}")"
                        data-brand="@brandName"
                        data-category="@item.Category.CategoryName"
                        data-branch="@item.Branch.BranchName"
                        data-status="@status">
                        <td class="py-3 px-3">
                            <div class="flex items-center gap-space-sm">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img class="w-12 h-9 rounded-lg object-cover bg-surface-container shrink-0" src="@item.ImageUrl" alt="@brandName @modelName" />
                                }
                                else
                                {
                                    <div class="w-12 h-9 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">directions_car</span>
                                    </div>
                                }
                                <div class="flex flex-col min-w-0">
                                    <span class="font-body-sm text-body-sm font-semibold text-on-surface truncate">@brandName @modelName</span>
                                    <span class="text-secondary text-[11px] truncate">@item.Year • @item.FuelType • @item.Transmission</span>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 px-3">
                            <span class="inline-block px-2 py-0.5 rounded bg-surface-container-high font-mono text-[12px] font-bold text-on-surface tracking-wider">@item.PlateNumber</span>
                        </td>
                        <td class="py-3 px-3 text-on-surface-variant font-medium">@brandName / @modelName</td>
                        <td class="py-3 px-3">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-badge text-label-badge">
                                <span class="material-symbols-outlined text-[14px]">category</span> @item.Category.CategoryName
                            </span>
                        </td>
                        <td class="py-3 px-3 text-secondary">@item.Branch.BranchName</td>
                        <td class="py-3 px-3 font-semibold text-on-surface">@item.DailyPrice.ToString("N0") ₺</td>
                        <td class="py-3 px-3">
                            @if (!item.IsActive)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container-highest text-secondary font-label-badge text-label-badge font-semibold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-outline"></span> Pasif
                                </span>
                            }
                            else if (item.IsAvailable)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-badge text-label-badge font-semibold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span> Müsait
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-fixed font-label-badge text-label-badge font-semibold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Kiralamada
                                </span>
                            }
                        </td>
                        <td class="py-3 px-3 text-right">
                            <div class="inline-flex items-center justify-end gap-1">
                                <a href="/Admin/Car/UpdateCar/@item.CarId" class="w-8 h-8 rounded-lg flex items-center justify-center text-primary hover:bg-surface-container-high transition-colors" title="Düzenle">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </a>
                                <form asp-area="Admin" asp-controller="Car" asp-action="DeleteCar" asp-route-id="@item.CarId" method="post" class="inline" onsubmit="return confirm('@item.PlateNumber plakalı aracı silmek istediğinize emin misiniz?');">
                                    <button class="w-8 h-8 rounded-lg flex items-center justify-center text-error hover:bg-error-container transition-colors" title="Sil" type="submit">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-space-md bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-space-md">
        <span id="carCount" class="font-body-sm text-body-sm text-secondary">
            Toplam <strong class="text-on-surface font-semibold">@Model.Count</strong> araç listeleniyor
        </span>
    </div>
</div>

<script>
    const searchInput = document.getElementById("carSearch");
    const brandFilter = document.getElementById("brandFilter");
    const categoryFilter = document.getElementById("categoryFilter");
    const branchFilter = document.getElementById("branchFilter");
    const statusFilter = document.getElementById("statusFilter");
    const rows = Array.from(document.querySelectorAll(".car-row"));
    const count = document.getElementById("carCount");

    function applyFilters() {
        const query = searchInput.value.trim().toLocaleLowerCase("tr");
        let visible = 0;
        rows.forEach(row => {
            const matchesSearch = row.dataset.search.toLocaleLowerCase("tr").includes(query);
            const matchesBrand = !brandFilter.value || row.dataset.brand === brandFilter.value;
            const matchesCategory = !categoryFilter.value || row.dataset.category === categoryFilter.value;
            const matchesBranch = !branchFilter.value || row.dataset.branch === branchFilter.value;
            const matchesStatus = !statusFilter.value || row.dataset.status === statusFilter.value;
            const show = matchesSearch && matchesBrand && matchesCategory && matchesBranch && matchesStatus;
            row.classList.toggle("hidden", !show);
            if (show) visible++;
        });
        count.innerHTML = `Toplam <strong class="text-on-surface font-semibold">${visible}</strong> araç listeleniyor`;
    }

    [searchInput, brandFilter, categoryFilter, branchFilter, statusFilter].forEach(el => el.addEventListener("input", applyFilters));
    brandFilter.addEventListener("change", applyFilters);
    categoryFilter.addEventListener("change", applyFilters);
    branchFilter.addEventListener("change", applyFilters);
    statusFilter.addEventListener("change", applyFilters);
</script>
