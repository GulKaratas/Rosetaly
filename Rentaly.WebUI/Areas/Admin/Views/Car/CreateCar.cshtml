@model Rentaly.EntityLayer.Entities.Car

@{
    ViewData["Title"] = "CreateCar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Yeni Araç Ekle", "Filoya yeni bir araç ve detay bilgilerini tanımlayın.", "Araçlar", "", "Listeye Dön", true, "/Admin/Car/CarList/"))
}

<form asp-action="CreateCar" method="post" enctype="multipart/form-data">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Sol & Orta Sütun: Form Alanları (2 Kolon) -->
        <div class="lg:col-span-2 flex flex-col gap-6">
            
            <!-- 1. Temel Tanımlama & Ruhsat Bilgileri -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-2 pb-4 mb-5 border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary text-[22px]">badge</span>
                    <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Temel Tanımlama & Ruhsat Bilgileri</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Plaka -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="PlateNumber">
                            Plaka <span class="text-error">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-bold px-1.5 py-0.5 rounded bg-primary-container text-on-primary">TR</span>
                            <input asp-for="PlateNumber" type="text" placeholder="34 ABC 789" required
                                   class="w-full pl-12 pr-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                        </div>
                        <span asp-validation-for="PlateNumber" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <!-- Şasi No / VIN -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider" asp-for="VIN">Şasi No / VIN</label>
                            <span class="text-[11px] text-outline">İsteğe Bağlı</span>
                        </div>
                        <input asp-for="VIN" type="text" maxlength="17" placeholder="17 haneli şasi no giriniz"
                               class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                        <span asp-validation-for="VIN" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <!-- Model Yılı -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="Year">
                            Model Yılı <span class="text-error">*</span>
                        </label>
                        <select asp-for="Year" required
                                class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all">
                            @for (int y = DateTime.Now.Year + 1; y >= 2015; y--)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                    </div>

                    <!-- Mevcut Kilometre -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="Kilometer">
                            Mevcut Kilometre <span class="text-error">*</span>
                        </label>
                        <div class="relative">
                            <input asp-for="Kilometer" type="number" min="0" placeholder="Örn: 24500" required
                                   class="w-full pl-4 pr-12 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-outline">km</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. İlişkisel Veriler & Lokasyon -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-2 pb-4 mb-5 border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary text-[22px]">hub</span>
                    <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">İlişkisel Veriler & Lokasyon</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Araç Modeli -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="CarModelId">
                            Araç Modeli <span class="text-error">*</span>
                        </label>
                        <select asp-for="CarModelId" asp-items="ViewBag.CarModels" required
                                class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all">
                            <option value="">Model Seçiniz</option>
                        </select>
                    </div>

                    <!-- Kategori -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="CategoryId">
                            Kategori / Segment <span class="text-error">*</span>
                        </label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" required
                                class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all">
                            <option value="">Kategori Seçiniz</option>
                        </select>
                    </div>

                    <!-- Bulunduğu Şube -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="BranchId">
                            Bulunduğu Şube <span class="text-error">*</span>
                        </label>
                        <select asp-for="BranchId" asp-items="ViewBag.Branches" required
                                class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all">
                            <option value="">Şube Seçiniz</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 3. Teknik Özellikler & Kapasite -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-2 pb-4 mb-5 border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary text-[22px]">tune</span>
                    <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Teknik Özellikler & Kapasite</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <!-- Yakıt Türü -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="FuelType">
                            Yakıt Türü <span class="text-error">*</span>
                        </label>
                        <select asp-for="FuelType" required
                                class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all">
                            <option value="Benzin">Benzin</option>
                            <option value="Dizel">Dizel</option>
                            <option value="Hibrit">Hibrit</option>
                            <option value="Elektrik">Elektrik</option>
                        </select>
                    </div>

                    <!-- Şanzıman -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="Transmission">
                            Şanzıman <span class="text-error">*</span>
                        </label>
                        <select asp-for="Transmission" required
                                class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all">
                            <option value="Otomatik">Otomatik</option>
                            <option value="Manuel">Manuel</option>
                            <option value="Yarı Otomatik">Yarı Otomatik</option>
                        </select>
                    </div>

                    <!-- Koltuk Sayısı -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="SeatCount">
                            Koltuk Sayısı <span class="text-error">*</span>
                        </label>
                        <div class="relative">
                            <input asp-for="SeatCount" type="number" min="1" max="15" value="5" required
                                   class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">airline_seat_recline_normal</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Bagaj Kapasitesi -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="LuggageCount">
                            Bagaj Kapasitesi (Valiz) <span class="text-error">*</span>
                        </label>
                        <div class="relative">
                            <input asp-for="LuggageCount" type="number" min="0" max="10" value="3" required
                                   class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">luggage</span>
                        </div>
                    </div>

                    <!-- Motor & Performans Bilgisi -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider" asp-for="PerformanceInfo">Performans / Motor</label>
                            <span class="text-[11px] text-outline">İsteğe Bağlı</span>
                        </div>
                        <input asp-for="PerformanceInfo" type="text" placeholder="Örn: 1.5 dCi 115 HP veya Dual Motor AWD"
                               class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                    </div>
                </div>
            </div>

            <!-- 4. Fiyatlandırma & Depozito -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-2 pb-4 mb-5 border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary text-[22px]">payments</span>
                    <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Fiyatlandırma & Güvence Bedeli</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Günlük Kiralama Fiyatı -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="DailyPrice">
                            Günlük Kiralama Fiyatı <span class="text-error">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-base font-bold text-primary">₺</span>
                            <input asp-for="DailyPrice" type="number" step="0.01" min="0" placeholder="1850.00" required
                                   class="w-full pl-9 pr-14 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm font-semibold text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-outline font-medium">/ Gün</span>
                        </div>
                    </div>

                    <!-- Güvence Bedeli / Depozito -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="DepositAmount">
                            Güvence Bedeli / Depozito <span class="text-error">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-base font-bold text-secondary">₺</span>
                            <input asp-for="DepositAmount" type="number" step="0.01" min="0" placeholder="5000.00" required
                                   class="w-full pl-9 pr-20 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm font-semibold text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-outline font-medium">Tek Sefer</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Görsel URL -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center gap-2 pb-4 mb-5 border-b border-outline-variant">
                    <span class="material-symbols-outlined text-primary text-[22px]">image</span>
                    <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Araç Görseli</h2>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="ImageUrl">Görsel URL Bağlantısı</label>
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">link</span>
                            <input asp-for="ImageUrl" type="url" placeholder="https://cdn.rentadmin.com/cars/megane-sedan.jpg"
                                   class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Aksiyon Butonları -->
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="reset" class="px-5 py-2.5 rounded-lg border border-outline-variant text-secondary hover:bg-surface-container-low text-sm font-medium transition-colors">
                    Formu Temizle
                </button>
                <a href="/Cars" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container-low text-sm font-medium transition-colors">
                    Vazgeç
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-primary-container text-on-primary font-semibold text-sm shadow-sm hover:bg-primary transition-colors">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Aracı Kaydet
                </button>
            </div>
        </div>

        <!-- Sağ Sütun: Canlı Önizleme & Rehber Bilgisi -->
        <div class="flex flex-col gap-6">
            
            <!-- Canlı Vitrin Kartı Simülasyonu -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 shadow-sm">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-outline-variant">
                    <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-secondary">
                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                        Canlı Kart Önizleme
                    </div>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-tertiary bg-tertiary-fixed/30 px-2 py-0.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span> Müsait
                    </span>
                </div>

                <div class="border border-outline-variant rounded-xl overflow-hidden bg-surface-container-low">
                    <div class="relative h-44 bg-surface-container-high flex items-center justify-center overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=600&q=80"
                             alt="Önizleme" class="w-full h-full object-cover" />
                        <span class="absolute top-2.5 left-2.5 bg-inverse-surface/80 backdrop-blur-sm text-inverse-on-surface text-[11px] font-semibold px-2 py-0.5 rounded">
                            Segment / Model
                        </span>
                        <span class="absolute bottom-2.5 right-2.5 bg-inverse-surface/80 backdrop-blur-sm text-inverse-on-surface text-[11px] font-semibold px-2 py-0.5 rounded">
                            2024 Model
                        </span>
                    </div>

                    <div class="p-4 bg-surface-container-lowest">
                        <div class="flex items-start justify-between mb-1">
                            <div>
                                <h3 class="font-bold text-on-surface text-base">Renault Megane Sedan</h3>
                                <span class="text-xs text-secondary font-mono">34 ABC 789</span>
                            </div>
                            <div class="text-right">
                                <span class="text-primary font-bold text-lg">1.850 ₺</span>
                                <span class="text-[11px] text-outline block">/ gün</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-2 py-3 my-3 border-y border-outline-variant text-center">
                            <div class="text-xs text-secondary flex flex-col items-center gap-0.5">
                                <span class="material-symbols-outlined text-[16px]">local_gas_station</span>
                                <span>Dizel</span>
                            </div>
                            <div class="text-xs text-secondary flex flex-col items-center gap-0.5">
                                <span class="material-symbols-outlined text-[16px]">settings</span>
                                <span>Otomatik</span>
                            </div>
                            <div class="text-xs text-secondary flex flex-col items-center gap-0.5">
                                <span class="material-symbols-outlined text-[16px]">airline_seat_recline_normal</span>
                                <span>5 Kişilik</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs text-secondary">
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">location_on</span> İstanbul - Kadıköy</span>
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">speed</span> 0 km</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kayıt & Doğrulama Rehberi -->
            <div class="bg-surface-container-low border border-outline-variant rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3 text-primary">
                    <span class="material-symbols-outlined text-[20px]">info</span>
                    <h4 class="text-sm font-semibold text-on-surface">Kayıt & Doğrulama Kuralları</h4>
                </div>
                <ul class="text-xs text-secondary space-y-2 leading-relaxed">
                    <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                        <span><strong>Plaka:</strong> Sistemde benzersiz olmalıdır; mükerrer plaka girişine izin verilmez.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                        <span><strong>Şasi No (VIN):</strong> Araç sigorta ve kasko takip entegrasyonu için önerilir.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                        <span><strong>Güvence Bedeli:</strong> Kiralama anında müşterinin kredi kartından otomatik provizyon olarak bloke edilir.</span>
                    </li>
                </ul>
            </div>

        </div>

    </div>
</form>


