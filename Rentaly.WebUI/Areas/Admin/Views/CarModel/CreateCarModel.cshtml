@model List<Rentaly.EntityLayer.Entities.CarModel>
@{
    ViewData["Title"] = "CreateCarModel";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Yeni Model Ekle", "Filoya yeni bir araç modeli tanımlayın ve markasıyla eşleştirin.", "Modeller", "", "Listeye Dön", true, "/Admin/CarModel/CarModelList/"))
}
<!-- Ana Yönetim Kartı & Tablo -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">
    
    <!-- Filtreleme ve Arama Çubuğu -->
    <div class="p-4 sm:p-5 border-b border-outline-variant bg-surface-container-lowest flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1 max-w-md relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input type="text" id="modelSearchInput" placeholder="Model adı veya marka ara..."
                   class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
        </div>
        
        <div class="flex items-center gap-3 flex-wrap">
            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="">Tüm Markalar</option>
                @if (ViewBag.Brands != null)
                {
                    foreach (var brand in ViewBag.Brands)
                    {
                        <option value="@brand.Value">@brand.Text</option>
                    }
                }
                else
                {
                    <option value="1">Renault</option>
                    <option value="2">BMW</option>
                    <option value="3">Mercedes-Benz</option>
                    <option value="4">Tesla</option>
                    <option value="5">Audi</option>
                }
            </select>

            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="name-asc">Sırala: A - Z</option>
                <option value="name-desc">Sırala: Z - A</option>
                <option value="brand-asc">Markaya Göre</option>
                <option value="id-desc">Son Eklenenler</option>
            </select>

            <button type="button" class="p-2 rounded-lg border border-outline-variant text-secondary hover:text-on-surface hover:bg-surface-container-low transition-colors" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[20px]">restart_alt</span>
            </button>
        </div>
    </div>

    <!-- Veri Tablosu -->
    <div class="overflow-x-auto w-full">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant text-secondary text-[12px] uppercase tracking-wider font-semibold">
                    <th class="py-3.5 px-4 w-12 text-center">
                        <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                    </th>
                    <th class="py-3.5 px-4 w-20">ID</th>
                    <th class="py-3.5 px-4">MODEL ADI</th>
                    <th class="py-3.5 px-4">BAĞLI MARKA</th>
                    <th class="py-3.5 px-4">FİLODAKİ ARAÇLAR</th>
                    <th class="py-3.5 px-4">DURUM</th>
                    <th class="py-3.5 px-4 text-right">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant text-sm">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-3.5 px-4 text-center">
                                <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                            </td>
                            <td class="py-3.5 px-4 font-mono text-xs text-secondary font-semibold">
                                #@item.CarModelId.ToString("D2")
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-lg bg-surface-container border border-outline-variant flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">directions_car</span>
                                    </div>
                                    <div>
                                        <span class="font-bold text-on-surface block text-sm">@item.ModelName</span>
                                        <span class="text-[11px] text-outline font-mono">Model ID: MDL-@item.CarModelId.ToString("D3")</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg bg-surface-container border border-outline-variant text-xs">
                                    <span class="material-symbols-outlined text-primary text-[15px]">military_tech</span>
                                    <span class="font-semibold text-on-surface">@(item.Brand?.BrandName ?? $"Marka #{item.BrandId}")</span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[15px] text-secondary">inventory_2</span>
                                    <span class="text-xs text-on-surface font-medium">Katalogda Tanımlı</span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    Aktif
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="inline-flex items-center gap-1">
                                    <a href="/Cars?modelId=@item.CarModelId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Modeldeki Araçları Gör">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </a>
                                    <a href="/CarModels/EditModel/@item.CarModelId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Düzenle">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    <a href="/CarModels/DeleteModel/@item.CarModelId" onclick="return confirm('@item.ModelName modelini silmek istediğinize emin misiniz?');" class="p-1.5 rounded-lg text-secondary hover:text-error hover:bg-error-container/30 transition-colors" title="Sil">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-secondary">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[40px] text-outline">inventory_2</span>
                                <p class="font-medium text-sm text-on-surface">Kayıtlı model bulunamadı.</p>
                                <p class="text-xs text-outline">Henüz bir araç modeli tanımlanmamış. İlk modelinizi ekleyebilirsiniz.</p>
                                <a href="/CarModels/CreateModel" class="mt-2 inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-primary-container text-on-primary text-xs font-semibold">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Yeni Model Ekle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Sayfalama ve Alt Özet -->
    <div class="p-4 sm:p-5 border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary">
        <div>
            Toplam <span class="font-bold text-on-surface">@(Model?.Count ?? 0)</span> modelden <span class="font-semibold text-on-surface">1 - @(Model?.Count ?? 0)</span> arası gösteriliyor
        </div>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 rounded-md border border-outline-variant text-outline hover:bg-surface-container-low transition-colors disabled:opacity-50" disabled>Önceki</button>
            <button class="px-3 py-1.5 rounded-md bg-primary-container text-on-primary font-semibold">1</button>
            <button class="px-3 py-1.5 rounded-md border border-outline-variant hover:bg-surface-container-low transition-colors">Sonraki</button>
        </div>
    </div>

</div>
