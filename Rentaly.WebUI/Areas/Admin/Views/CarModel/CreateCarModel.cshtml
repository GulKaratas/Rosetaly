@model CarModel
@{
    ViewData["Title"] = "CreateCarModel";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Yeni Model Ekle", "Filoya yeni bir araç modeli tanımlayın ve markasıyla eşleştirin.", "Modeller", "", "Listeye Dön", true, "/Admin/CarModel/CarModelList/"))
}

<form asp-area="Admin" asp-controller="CarModel" asp-action="CreateCarModel" method="post" class="flex flex-col gap-6 w-full">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm p-6 flex flex-col gap-5">
        <div class="flex items-center justify-between pb-3 bg-surface-container-low/40 -mx-6 -mt-6 p-6 rounded-t-xl">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-primary-fixed flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">badge</span>
                </div>
                <div class="flex flex-col">
                    <h2 class="font-headline-md text-headline-md text-on-surface font-semibold">1. Temel Model &amp; Marka Bilgileri</h2>
                    <p class="font-body-sm text-body-sm text-secondary">Katalog model adı ve bağlı olacağı marka.</p>
                </div>
            </div>
            <span class="text-outline font-table-header text-table-header tracking-wider uppercase">Entity: CarModel</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
                <label class="font-table-header text-table-header text-on-surface font-semibold flex items-center gap-1" asp-for="ModelName">
                    <span>Model Adı / İsimlendirme</span>
                    <span class="text-error">*</span>
                </label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3 text-secondary text-[18px]">title</span>
                    <input asp-for="ModelName" class="w-full pl-9 pr-3 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg shadow-sm focus:bg-surface-container-low transition-colors outline-none" placeholder="Örn: 320i, Clio, A4" required type="text" />
                </div>
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="font-table-header text-table-header text-on-surface font-semibold flex items-center gap-1" asp-for="BrandId">
                    <span>Bağlı Marka (Brand)</span>
                    <span class="text-error">*</span>
                </label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3 text-secondary text-[18px]">military_tech</span>
                    <select asp-for="BrandId" asp-items="ViewBag.Brands" class="w-full pl-9 pr-8 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg shadow-sm focus:bg-surface-container-low transition-colors outline-none appearance-none cursor-pointer" required>
                        <option value="">Marka seçiniz</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 pointer-events-none text-outline text-[18px]">unfold_more</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-surface-container-low rounded-xl p-5 flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-[22px]">account_tree</span>
        </div>
        <div>
            <h3 class="font-headline-md text-headline-md text-on-surface">Marka → Model</h3>
            <p class="font-body-sm text-body-sm text-secondary mt-1">Marka listesi veritabanından gelir. Model kaydı oluşunca araç ekleme ekranında bu markanın altında seçilir. Yakıt, vites ve plaka bilgisi araç kaydındadır.</p>
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl shadow-sm p-4 md:p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-error text-[18px]">emergency</span>
            <span>Yıldızlı alanlar zorunludur.</span>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
            <a class="w-full sm:w-auto px-5 py-2.5 bg-surface-container-low hover:bg-surface-container text-on-surface rounded-lg font-label-nav-item text-label-nav-item transition-colors text-center" href="/Admin/CarModel/CarModelList">Vazgeç</a>
            <button class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary-container text-on-primary rounded-lg font-label-nav-item text-label-nav-item shadow-sm hover:opacity-95 transition-all" type="submit">
                <span class="material-symbols-outlined text-[18px]">add_task</span>
                <span>Modeli Kaydet</span>
            </button>
        </div>
    </div>
</form>
