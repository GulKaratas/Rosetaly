@model List<Rentaly.EntityLayer.Entities.Brand>
@{
    ViewData["Title"] = "BrandList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Markalar", "Araç markalarının kayıtlı olduğu liste ve yönetim paneli", "Markalar", "/Admin/Brand/CreateBrand/", "Yeni Marka Ekle", false, ""))
}

<!-- Ana Yönetim Kartı & Tablo -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">

    <!-- Filtreleme ve Arama Çubuğu -->
    <div class="p-4 sm:p-5 border-b border-outline-variant bg-surface-container-lowest flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1 max-w-md relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input type="text" id="brandSearchInput" placeholder="Marka adı ile ara..."
                   class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
        </div>

        <div class="flex items-center gap-3 flex-wrap">
            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="">Tüm Model Durumları</option>
                <option value="with-models">Modeli Olanlar</option>
                <option value="empty">Modeli Olmayanlar</option>
            </select>

            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="name-asc">Sırala: A - Z</option>
                <option value="name-desc">Sırala: Z - A</option>
                <option value="models-desc">En Çok Model</option>
                <option value="id-desc">Son Eklenenler</option>
            </select>

            <button type="button" class="p-2 rounded-lg border border-outline-variant text-secondary hover:text-on-surface hover:bg-surface-container-low transition-colors" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[20px]">restart_alt</span>
            </button>
        </div>
    </div>

    <!-- Veri Tablosu -->
    <div class="overflow-x-auto w-full">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant text-secondary text-[12px] uppercase tracking-wider font-semibold">
                    <th class="py-3.5 px-4 w-12 text-center">
                        <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                    </th>
                    <th class="py-3.5 px-4 w-20">ID</th>
                    <th class="py-3.5 px-4">MARKA LOGOSU & ADI</th>
                    <th class="py-3.5 px-4">KAYITLI MODELLER</th>
                    <th class="py-3.5 px-4">GÖRSEL DURUMU</th>
                    <th class="py-3.5 px-4">DURUM</th>
                    <th class="py-3.5 px-4 text-right">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant text-sm">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var modelCount = item.CarModels?.Count ?? 0;
                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-3.5 px-4 text-center">
                                <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                            </td>
                            <td class="py-3.5 px-4 font-mono text-xs text-secondary font-semibold">
                                #@item.BrandId.ToString("D2")
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container border border-outline-variant flex items-center justify-center overflow-hidden shrink-0">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.BrandName" class="w-full h-full object-contain p-1" onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'24\' height=\'24\' fill=\'%23565e74\' viewBox=\'0 0 24 24\'><path d=\'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\'/></svg>';" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined text-outline text-[20px]">military_tech</span>
                                        }
                                    </div>
                                    <div>
                                        <span class="font-bold text-on-surface block text-sm">@item.BrandName</span>
                                        <span class="text-[11px] text-outline font-mono">slug: @item.BrandName.ToLower().Replace(" ", "-")</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[16px] text-primary">directions_car</span>
                                    <span class="font-semibold text-on-surface">@modelCount</span>
                                    <span class="text-xs text-secondary">Model Tanımlı</span>
                                </div>
                                @if (modelCount > 0 && item.CarModels != null)
                                {
                                    <div class="text-[11px] text-outline mt-0.5 truncate max-w-xs">
                                        @string.Join(", ", item.CarModels.Take(3).Select(m => m.ModelName ?? "Model")) @(modelCount > 3 ? "..." : "")
                                    </div>
                                }
                            </td>
                            <td class="py-3.5 px-4">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container-high text-primary">
                                        <span class="material-symbols-outlined text-[14px]">link</span>
                                        Görsel Tanımlı
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container-low text-outline">
                                        <span class="material-symbols-outlined text-[14px]">hide_image</span>
                                        Görsel Yok
                                    </span>
                                }
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    Aktif
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="inline-flex items-center gap-1">
                                    <a href="/CarModels?brandId=@item.BrandId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Modellerini Gör">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </a>
                                    <a href="/Brands/EditBrand/@item.BrandId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Düzenle">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    <a href="/Brands/DeleteBrand/@item.BrandId" onclick="return confirm('@item.BrandName markasını silmek istediğinize emin misiniz?');" class="p-1.5 rounded-lg text-secondary hover:text-error hover:bg-error-container/30 transition-colors" title="Sil">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-secondary">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[40px] text-outline">military_tech</span>
                                <p class="font-medium text-sm text-on-surface">Kayıtlı marka bulunamadı.</p>
                                <p class="text-xs text-outline">Henüz bir marka tanımlanmamış. İlk markanızı ekleyebilirsiniz.</p>
                                <a href="/Brands/CreateBrand" class="mt-2 inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-primary-container text-on-primary text-xs font-semibold">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Yeni Marka Ekle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Sayfalama ve Alt Özet -->
    <div class="p-4 sm:p-5 border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary">
        <div>
            Toplam <span class="font-bold text-on-surface">@(Model?.Count ?? 0)</span> markadan <span class="font-semibold text-on-surface">1 - @(Model?.Count ?? 0)</span> arası gösteriliyor
        </div>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 rounded-md border border-outline-variant text-outline hover:bg-surface-container-low transition-colors disabled:opacity-50" disabled>Önceki</button>
            <button class="px-3 py-1.5 rounded-md bg-primary-container text-on-primary font-semibold">1</button>
            <button class="px-3 py-1.5 rounded-md border border-outline-variant hover:bg-surface-container-low transition-colors">Sonraki</button>
        </div>
    </div>

</div>

