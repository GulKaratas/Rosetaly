@model List<ResultCategoryDto>
@{
    ViewData["Title"] = "CategoryList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Kategoriler", "Araç kategorilerinin yönetim listesi", "Kategoriler", "/Admin/Category/CreateCategory/", "Yeni Kategori Ekle", false, ""))
}

<div class="bg-surface-container-lowest rounded-xl shadow-sm flex flex-col overflow-hidden">
    <div class="p-space-md bg-surface-container-lowest flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-space-md">
        <div class="relative flex-1 max-w-md">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input class="w-full pl-9 pr-space-md py-space-xs bg-surface-container-low rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline outline-none focus:bg-surface-container transition-colors" placeholder="Kategori adı ara..." type="text" />
        </div>
        <div class="flex items-center gap-space-sm flex-wrap">
            <div class="relative">
                <select class="appearance-none bg-surface-container-low text-on-surface font-body-sm text-body-sm py-space-xs pl-space-md pr-8 rounded-lg outline-none cursor-pointer focus:bg-surface-container transition-colors">
                    <option value="sort-asc">Sıralama: A - Z</option>
                    <option value="sort-desc">Sıralama: Z - A</option>
                    <option value="date-new">Sıralama: En Yeni</option>
                </select>
                <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline text-[18px] pointer-events-none">swap_vert</span>
            </div>
            <button class="w-9 h-9 flex items-center justify-center bg-surface-container-low hover:bg-surface-container text-secondary rounded-lg transition-colors" title="Filtreleri Temizle" type="button">
                <span class="material-symbols-outlined text-[18px]">filter_alt_off</span>
            </button>
        </div>
    </div>

    <div class="w-full overflow-x-auto">
        <table class="w-full text-left font-body-md text-body-md">
            <thead>
                <tr class="bg-surface-container-low font-table-header text-table-header text-secondary uppercase tracking-wider">
                    <th class="py-3 px-4 w-12 text-center" scope="col">
                        <input class="w-4 h-4 rounded text-primary focus:ring-0 cursor-pointer accent-primary" type="checkbox" />
                    </th>
                    <th class="py-3 px-4" scope="col">ID</th>
                    <th class="py-3 px-4" scope="col">Kategori Adı</th>
                    <th class="py-3 px-4" scope="col">Durum</th>
                    <th class="py-3 px-4 text-right" scope="col">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-surface-container-low/60 transition-colors group">
                        <td class="py-3 px-4 text-center">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 cursor-pointer accent-primary" type="checkbox" />
                        </td>
                        <td class="py-3 px-4 font-mono text-body-sm font-semibold text-secondary">#CAT-@item.CategoryId.ToString("D2")</td>
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-space-sm">
                                <div class="w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform">
                                    <span class="material-symbols-outlined text-[20px]">category</span>
                                </div>
                                <div class="flex flex-col">
                                    <span class="font-headline-md text-body-md font-semibold text-on-surface">@item.CategoryName</span>
                                    <span class="font-body-sm text-[11px] text-outline">CAT-@item.CategoryId.ToString("D4")</span>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-badge text-label-badge bg-tertiary-fixed text-on-tertiary-fixed">
                                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                                Aktif
                            </span>
                        </td>
                        <td class="py-3 px-4 text-right">
                            <div class="inline-flex items-center justify-end gap-1">
                                <a class="w-8 h-8 rounded-lg flex items-center justify-center text-secondary hover:bg-surface-container hover:text-primary transition-colors" href="/Admin/Category/UpdateCategory/@item.CategoryId" title="Düzenle">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </a>
                                <form asp-area="Admin" asp-controller="Category" asp-action="DeleteCategory" asp-route-id="@item.CategoryId" method="post" class="inline" onsubmit="return confirm('@item.CategoryName kategorisini silmek istediğinize emin misiniz?');">
                                    <button class="w-8 h-8 rounded-lg flex items-center justify-center text-error hover:bg-error-container hover:text-on-error-container transition-colors" title="Sil" type="submit">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-space-md bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-space-md">
        <span class="font-body-sm text-body-sm text-secondary">
            Toplam <strong class="text-on-surface">@Model.Count</strong> kayıttan <strong class="text-on-surface">1-@Model.Count</strong> arası gösteriliyor
        </span>
        <div class="flex items-center gap-1">
            <button class="px-space-sm py-1 rounded-lg text-secondary opacity-50 cursor-not-allowed flex items-center gap-1 font-body-sm text-body-sm" disabled type="button">
                <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                <span>Önceki</span>
            </button>
            <button class="w-8 h-8 rounded-lg bg-primary-container text-on-primary font-body-sm text-body-sm font-semibold flex items-center justify-center shadow-sm" type="button">1</button>
            <button class="px-space-sm py-1 rounded-lg text-on-surface hover:bg-surface-container transition-colors flex items-center gap-1 font-body-sm text-body-sm" type="button">
                <span>Sonraki</span>
                <span class="material-symbols-outlined text-[18px]">chevron_right</span>
            </button>
        </div>
    </div>
</div>
