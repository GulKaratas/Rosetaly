@model UpdateCategoryDto
@{
    ViewData["Title"] = "UpdateCategory";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", (
        "Kategori Bilgilerini Güncelle",
        "Kayıtlı araç kategorisinin adını düzenleyebilirsiniz.",
        "Kategoriler",
        "",
        "Listeye Dön",
        true,
        "/Admin/Category/CategoryList/"
    ))
}

<div class="w-full bg-surface-container-low rounded-xl p-space-md mb-space-lg flex items-center gap-space-md">
    <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
        <span class="material-symbols-outlined text-[24px]">category</span>
    </div>
    <div>
        <div class="flex items-center gap-space-xs">
            <span class="font-headline-md text-headline-md text-on-surface">@Model.CategoryName</span>
            <span class="font-body-sm text-body-sm text-secondary">(Kategori Kaydı)</span>
        </div>
        <span class="font-body-sm text-body-sm text-secondary flex items-center gap-1 mt-0.5">
            <span class="material-symbols-outlined text-[15px] text-tertiary">badge</span>
            Kategori ID: #CAT-@Model.CategoryId.ToString("D4")
        </span>
    </div>
</div>

<form asp-area="Admin" asp-controller="Category" asp-action="UpdateCategory" method="post">
    <input type="hidden" asp-for="CategoryId" />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 flex flex-col gap-6">
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-outline-variant">
                    <div>
                        <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Kategori Bilgisi</h2>
                        <p class="text-body-sm text-secondary mt-0.5">Kayıtlı tanım ve sistem kodu</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-high text-primary">Genel Tanım</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5">Kategori ID</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock</span>
                            <input class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface font-mono cursor-not-allowed focus:outline-none" readonly type="text" value="#CAT-@Model.CategoryId.ToString("D4")" />
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider" asp-for="CategoryName">
                                Kategori Adı <span class="text-error">*</span>
                            </label>
                            <span class="text-xs text-outline font-mono">@Model.CategoryName.Length / 50</span>
                        </div>
                        <input asp-for="CategoryName" type="text" maxlength="50" required
                               class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                        <span asp-validation-for="CategoryName" class="text-error text-xs mt-1 block"></span>
                        <p class="text-xs text-secondary mt-1.5">Araç ekleme ve arama filtrelerinde bu ad görünür.</p>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-6 mt-6 border-t border-outline-variant">
                    <span class="text-xs text-secondary"><strong class="text-error">*</strong> ile işaretli alanlar zorunludur</span>
                    <div class="flex items-center gap-3">
                        <a href="/Admin/Category/CategoryList" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container-low text-sm font-medium transition-colors">
                            Vazgeç
                        </a>
                        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-primary-container text-on-primary font-semibold text-sm shadow-sm hover:bg-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">save</span>
                            Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </div>

            <div class="bg-surface-container-low border border-outline-variant rounded-xl p-5 flex items-start gap-4">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[20px]">info</span>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-on-surface mb-1">Kategori Hiyerarşisi</h4>
                    <p class="text-xs text-secondary leading-relaxed">Ad değişikliği, bu kategoriye bağlı araç kayıtlarında ve sitedeki arama filtresinde görünür.</p>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-6">
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 shadow-sm">
                <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-secondary pb-3 mb-4 border-b border-outline-variant">
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                    Kayıt Özeti
                </div>
                <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-primary text-on-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[22px]">category</span>
                    </div>
                    <div>
                        <div class="font-semibold text-on-surface text-sm">@Model.CategoryName</div>
                        <div class="text-xs text-secondary font-mono">#CAT-@Model.CategoryId.ToString("D4")</div>
                    </div>
                </div>
            </div>

            <div class="bg-surface-container-low border border-outline-variant rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3 text-primary">
                    <span class="material-symbols-outlined text-[20px]">lightbulb</span>
                    <h4 class="text-sm font-semibold text-on-surface">İpuçları</h4>
                </div>
                <ul class="text-xs text-secondary space-y-3 leading-relaxed">
                    <li class="flex items-start gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-primary/10 text-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">1</span>
                        <span><strong>Karakter Limiti:</strong> Kategori adı 2–50 karakter arasında olmalıdır.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-primary/10 text-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">2</span>
                        <span><strong>Benzersizlik:</strong> Mevcut kategorilerle aynı isim kullanmaktan kaçının.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-primary/10 text-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">3</span>
                        <span><strong>Filo Sınıfı:</strong> Sedan, SUV veya lüks gibi kiralama paketlerini bu adla gruplayın.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
