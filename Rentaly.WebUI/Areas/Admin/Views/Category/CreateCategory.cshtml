@model Rentaly.EntityLayer.Entities.Category
@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Yeni Kategori Ekle", "Araç filosuna yeni bir kategori tanımlayın.", "Kategoriler", "", "Listeye Dön", true, "/Admin/Category/CategoryList/"))
}
<form asp-action="CreateCategory" method="post">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Sol & Orta Sütun: Kategori Form Alanı (2 Kolon) -->
        <div class="lg:col-span-2 flex flex-col gap-6">

            <!-- Kategori Bilgisi Kartı -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-outline-variant">
                    <div>
                        <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Kategori Bilgisi</h2>
                        <p class="text-body-sm text-secondary mt-0.5">Temel tanımlama bilgisi</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-high text-primary">Genel Tanım</span>
                </div>

                <div class="flex flex-col gap-6">
                    <!-- Kategori Adı -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider" for="CategoryName">
                                Kategori Adı <span class="text-error">*</span>
                            </label>
                            <span class="text-xs text-outline font-mono">0 / 50</span>
                        </div>
                        <input id="CategoryName" name="CategoryName" type="text" maxlength="50" required placeholder="Örn: Lüks & Premium"
                               class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                        <p class="text-xs text-secondary mt-1.5">Kısa ve anlamlı bir isim girin. Büyük-küçük harf duyarlı değildir.</p>
                    </div>

                    <!-- Kategori İkonu -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1">
                            Kategori İkonu
                        </label>
                        <p class="text-xs text-secondary mb-3">Listede görünecek ikon — isteğe bağlı</p>

                        <!-- İkon Seçim Izgarası -->
                        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2.5">
                            <label class="cursor-pointer">
                                <input type="radio" name="IconType" value="sedan" class="peer sr-only" checked />
                                <div class="flex flex-col items-center justify-center p-3 rounded-lg border border-outline-variant bg-surface-container-low peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-surface-container transition-all text-center">
                                    <span class="material-symbols-outlined text-[24px] mb-1">directions_car</span>
                                    <span class="text-xs font-medium">Sedan</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="IconType" value="suv" class="peer sr-only" />
                                <div class="flex flex-col items-center justify-center p-3 rounded-lg border border-outline-variant bg-surface-container-low peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-surface-container transition-all text-center">
                                    <span class="material-symbols-outlined text-[24px] mb-1">airport_shuttle</span>
                                    <span class="text-xs font-medium">SUV</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="IconType" value="luxury" class="peer sr-only" />
                                <div class="flex flex-col items-center justify-center p-3 rounded-lg border border-outline-variant bg-surface-container-low peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-surface-container transition-all text-center">
                                    <span class="material-symbols-outlined text-[24px] mb-1">diamond</span>
                                    <span class="text-xs font-medium">Lüks</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="IconType" value="minivan" class="peer sr-only" />
                                <div class="flex flex-col items-center justify-center p-3 rounded-lg border border-outline-variant bg-surface-container-low peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-surface-container transition-all text-center">
                                    <span class="material-symbols-outlined text-[24px] mb-1">rv_hookup</span>
                                    <span class="text-xs font-medium">Minivan</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="IconType" value="electric" class="peer sr-only" />
                                <div class="flex flex-col items-center justify-center p-3 rounded-lg border border-outline-variant bg-surface-container-low peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-surface-container transition-all text-center">
                                    <span class="material-symbols-outlined text-[24px] mb-1">bolt</span>
                                    <span class="text-xs font-medium">Elektrik</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="IconType" value="sports" class="peer sr-only" />
                                <div class="flex flex-col items-center justify-center p-3 rounded-lg border border-outline-variant bg-surface-container-low peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:text-primary hover:bg-surface-container transition-all text-center">
                                    <span class="material-symbols-outlined text-[24px] mb-1">speed</span>
                                    <span class="text-xs font-medium">Spor</span>
                                </div>
                            </label>
                        </div>
                        <p class="text-[11px] text-outline mt-2">İkon seçimi veritabanına kaydedilmez; yalnızca görsel amaçlıdır.</p>
                    </div>

                    <!-- Renk Etiketi -->
                    <div>
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1">
                            Renk Etiketi
                        </label>
                        <p class="text-xs text-secondary mb-3">Kategori için temsil rengi — isteğe bağlı</p>

                        <div class="flex items-center gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="ColorBadge" value="blue" class="peer sr-only" checked />
                                <div class="w-8 h-8 rounded-full bg-blue-600 ring-2 ring-transparent peer-checked:ring-offset-2 peer-checked:ring-primary flex items-center justify-center text-white transition-all">
                                    <span class="material-symbols-outlined text-[16px]">check</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="ColorBadge" value="emerald" class="peer sr-only" />
                                <div class="w-8 h-8 rounded-full bg-emerald-600 ring-2 ring-transparent peer-checked:ring-offset-2 peer-checked:ring-emerald-600 flex items-center justify-center text-white transition-all"></div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="ColorBadge" value="indigo" class="peer sr-only" />
                                <div class="w-8 h-8 rounded-full bg-indigo-600 ring-2 ring-transparent peer-checked:ring-offset-2 peer-checked:ring-indigo-600 flex items-center justify-center text-white transition-all"></div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="ColorBadge" value="slate" class="peer sr-only" />
                                <div class="w-8 h-8 rounded-full bg-slate-600 ring-2 ring-transparent peer-checked:ring-offset-2 peer-checked:ring-slate-600 flex items-center justify-center text-white transition-all"></div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="ColorBadge" value="amber" class="peer sr-only" />
                                <div class="w-8 h-8 rounded-full bg-amber-600 ring-2 ring-transparent peer-checked:ring-offset-2 peer-checked:ring-amber-600 flex items-center justify-center text-white transition-all"></div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="ColorBadge" value="rose" class="peer sr-only" />
                                <div class="w-8 h-8 rounded-full bg-rose-600 ring-2 ring-transparent peer-checked:ring-offset-2 peer-checked:ring-rose-600 flex items-center justify-center text-white transition-all"></div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Alt Aksiyon & Bilgilendirme -->
                <div class="flex items-center justify-between pt-6 mt-6 border-t border-outline-variant">
                    <span class="text-xs text-secondary"><strong class="text-error">*</strong> ile işaretli alanlar zorunludur</span>
                    <div class="flex items-center gap-3">
                        <a href="/Categories" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container-low text-sm font-medium transition-colors">
                            Vazgeç
                        </a>
                        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-primary-container text-on-primary font-semibold text-sm shadow-sm hover:bg-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">check</span>
                            Kategoriyi Kaydet
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bilgilendirme Kartı -->
            <div class="bg-surface-container-low border border-outline-variant rounded-xl p-5 flex items-start gap-4">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[20px]">info</span>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-on-surface mb-1">Kategori Hiyerarşisi</h4>
                    <p class="text-xs text-secondary leading-relaxed">Eklenen yeni kategori doğrudan araç modelleri oluşturulurken sınıflandırma filtrelerinde ve web sitesi ana arama çubuğunda anında listelenmeye başlar.</p>
                </div>
            </div>

        </div>

        <!-- Sağ Sütun: Canlı Önizleme & İpuçları Paneli -->
        <div class="flex flex-col gap-6">

            <!-- Canlı Önizleme Simülasyonu -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 shadow-sm">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-outline-variant">
                    <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-secondary">
                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                        Canlı Önizleme
                    </div>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-tertiary bg-tertiary-fixed/30 px-2 py-0.5 rounded-full">
                        CANLI
                    </span>
                </div>
                <p class="text-xs text-secondary mb-4">Kategori listesindeki görünümü</p>

                <!-- Önizleme Kartı -->
                <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant flex items-center justify-between mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-primary text-on-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-[22px]">directions_car</span>
                        </div>
                        <div>
                            <div class="font-semibold text-on-surface text-sm">Lüks & Premium</div>
                            <div class="text-xs text-secondary">Aktif Filo Sınıfı • 0 Model Tanımlı</div>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-outline text-[18px]">arrow_forward</span>
                </div>

                <!-- Tablodaki Görünüm Simülasyonu -->
                <div class="text-xs font-semibold text-secondary uppercase tracking-wider mb-2 flex items-center justify-between">
                    <span>Tablodaki Görünüm</span>
                    <span class="text-[11px] font-normal text-outline">Simülasyon</span>
                </div>
                <div class="border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest text-xs">
                    <div class="bg-surface-container-low px-3 py-2 border-b border-outline-variant flex items-center justify-between font-semibold text-secondary">
                        <span>KOD / İSİM</span>
                        <span>DURUM</span>
                    </div>
                    <div class="p-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" class="rounded border-outline-variant" />
                            <div class="w-6 h-6 rounded bg-primary/10 text-primary flex items-center justify-center">
                                <span class="material-symbols-outlined text-[14px]">directions_car</span>
                            </div>
                            <div>
                                <span class="font-medium text-on-surface block">Lüks & Premium</span>
                                <span class="text-[10px] text-outline font-mono">#CAT-48 • 0 Araç Kayıtlı</span>
                            </div>
                        </div>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700">Aktif</span>
                    </div>
                </div>

                <!-- Toplam İstatistik Küçük Rozeti -->
                <div class="mt-4 p-3 rounded-lg bg-surface-container-high/60 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2 text-secondary">
                        <span class="material-symbols-outlined text-[16px] text-primary">category</span>
                        <span>Toplam Kategori</span>
                    </div>
                    <span class="font-bold text-primary text-sm">15</span>
                </div>
            </div>

            <!-- İpuçları Paneli -->
            <div class="bg-surface-container-low border border-outline-variant rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3 text-primary">
                    <span class="material-symbols-outlined text-[20px]">lightbulb</span>
                    <h4 class="text-sm font-semibold text-on-surface">İpuçları</h4>
                </div>
                <ul class="text-xs text-secondary space-y-3 leading-relaxed">
                    <li class="flex items-start gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-primary/10 text-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">1</span>
                        <span><strong>Karakter Limiti:</strong> Kategori adı 2–50 karakter arasında olmalıdır.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-primary/10 text-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">2</span>
                        <span><strong>Benzersizlik:</strong> Mevcut kategorilerle aynı isim kullanmaktan kaçının.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-primary/10 text-primary font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">3</span>
                        <span><strong>Görsel Seçim:</strong> İkon ve renk seçimi yalnızca görsel; veritabanına kaydedilmez.</span>
                    </li>
                </ul>
            </div>

            <!-- Sistem Standartları Kutusu -->
            <div class="bg-inverse-surface text-inverse-on-surface rounded-xl p-5 shadow-sm">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] font-semibold text-secondary-fixed-dim uppercase tracking-wider">SİSTEM STANDARTLARI</span>
                    <span class="material-symbols-outlined text-outline text-[16px]">verified</span>
                </div>
                <h5 class="text-sm font-bold mb-1 text-white">Filo Sınıflandırma Mantığı</h5>
                <p class="text-xs text-secondary-fixed-dim leading-relaxed">Kategoriler araç tiplerini (Sedan, Hatchback, SUV vb.) veya kiralama paketlerini (Ekonomik, Lüks, Ticari) gruplandırmak için kullanılır.</p>
            </div>

        </div>

    </div>
</form>