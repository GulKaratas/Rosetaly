@using Rentaly.DtoLayer.RentalDtos
@model List<ResultRentalDto>
@{
    ViewData["Title"] = "RentalList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Kiralamalar", "Sistemdeki tüm araç kiralama rezervasyonları ve durum yönetimi", "Kiralamalar", "/Admin/Rental/CreateRental/", "Yeni Kiralama Ekle", false, ""))
}

<!-- Ana Yönetim Kartı & Tablo (Üst kutular kaldırılmış, doğrudan filtre ve tablo odaklı) -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">
    
    <!-- Filtreleme ve Arama Çubuğu -->
    <div class="p-4 sm:p-5 border-b border-outline-variant bg-surface-container-lowest flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1 max-w-md relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input type="text" id="rentalSearchInput" placeholder="Kiralama ID, plaka, müşteri adı veya sözleşme ara..."
                   class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
        </div>
        
        <div class="flex items-center gap-3 flex-wrap">
            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="">Tüm Kiralama Durumları</option>
                <option value="Aktif">Aktif / Devam Edenler</option>
                <option value="Rezervasyon">Rezervasyon</option>
                <option value="Tamamlandı">Tamamlananlar</option>
                <option value="İptal">İptal Edilenler</option>
            </select>

            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="">Tüm Şubeler</option>
                <option value="1">Merkez Şube (Kadıköy)</option>
                <option value="2">İstanbul Havalimanı Şube</option>
                <option value="3">Sabiha Gökçen Şube</option>
                <option value="4">Ankara Çankaya Şube</option>
                <option value="5">İzmir Adnan Menderes Şube</option>
            </select>

            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="id-desc">Son Eklenenler</option>
                <option value="date-asc">Alış Tarihine Göre (Yakın-Uzak)</option>
                <option value="price-desc">Tutara Göre (Yüksek-Düşük)</option>
                <option value="price-asc">Tutara Göre (Düşük-Yüksek)</option>
            </select>

            <button type="button" class="p-2 rounded-lg border border-outline-variant text-secondary hover:text-on-surface hover:bg-surface-container-low transition-colors" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[20px]">restart_alt</span>
            </button>
        </div>
    </div>

    <!-- Veri Tablosu -->
    <div class="overflow-x-auto w-full">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant text-secondary text-[12px] uppercase tracking-wider font-semibold">
                    <th class="py-3.5 px-4 w-12 text-center">
                        <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                    </th>
                    <th class="py-3.5 px-4 w-20">SÖZLEŞME ID</th>
                    <th class="py-3.5 px-4 min-w-[240px]">KİRALANAN ARAÇ</th>
                    <th class="py-3.5 px-4 min-w-[180px]">KİRACI MÜŞTERİ</th>
                    <th class="py-3.5 px-4 min-w-[200px]">TESLİM ALMA & İADE ŞUBESİ</th>
                    <th class="py-3.5 px-4 min-w-[180px]">TARİH & SÜRE</th>
                    <th class="py-3.5 px-4">TOPLAM TUTAR</th>
                    <th class="py-3.5 px-4">DURUM</th>
                    <th class="py-3.5 px-4 text-right">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant text-sm">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var totalDays = (int)(item.ReturnDate - item.PickupDate).TotalDays;
                        if (totalDays <= 0) totalDays = 1;

                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-3.5 px-4 text-center">
                                <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                            </td>
                            <td class="py-3.5 px-4 font-mono text-xs text-secondary font-semibold">
                                #RNT-@item.RentalId.ToString("D4")
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container border border-outline-variant flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">directions_car</span>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-on-surface text-sm">
                                               Araç
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            <span class="font-mono text-[11px] font-bold text-primary bg-primary/10 px-1.5 py-0.5 rounded">
                                                platenumber
                                            </span>
                                            <span class="text-[11px] text-outline font-mono">ID: CAR-@item.CarId.ToString("D3")</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-full bg-primary-container/10 text-primary border border-outline-variant flex items-center justify-center font-bold text-xs shrink-0">
                                        M
                                    </div>
                                    <div>
                                        <span class="font-semibold text-on-surface block text-sm">Müşteri #@item.CustomerId</span>
                                        <span class="text-[11px] text-outline font-mono">CST-@item.CustomerId.ToString("D4")</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex flex-col gap-1 text-xs">
                                    <div class="flex items-center gap-1.5 text-on-surface">
                                        <span class="material-symbols-outlined text-[14px] text-primary">arrow_circle_up</span>
                                        <span>Alış: <strong>Şube #@item.PickupBranchId</strong></span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-secondary">
                                        <span class="material-symbols-outlined text-[14px] text-outline">arrow_circle_down</span>
                                        <span>İade: <strong>Şube #@item.ReturnBranchId</strong></span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex flex-col gap-0.5">
                                    <span class="text-xs font-semibold text-on-surface">
                                        @item.PickupDate.ToString("dd.MM.yyyy") - @item.ReturnDate.ToString("dd.MM.yyyy")
                                    </span>
                                    <span class="text-[11px] text-secondary">
                                        Toplam <strong>@totalDays Gün</strong> Kiralama
                                    </span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="font-bold text-sm text-primary">
                                    @item.TotalPrice.ToString("N2") ₺
                                </div>
                                <span class="text-[10px] text-outline">KDV Dahil</span>
                            </td>
                            <td class="py-3.5 px-4">
                                @if (item.Status == "Aktif" || item.Status == "Devam Ediyor")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                        @item.Status
                                    </span>
                                }
                                else if (item.Status == "Rezervasyon")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                                        @item.Status
                                    </span>
                                }
                                else if (item.Status == "Tamamlandı")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                                        @item.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
                                        @item.Status
                                    </span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="inline-flex items-center gap-1">
                                    <a href="/Rentals/Contract/@item.RentalId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Sözleşmeyi Gör / Yazdır">
                                        <span class="material-symbols-outlined text-[18px]">description</span>
                                    </a>
                                    <a href="/Rentals/EditRental/@item.RentalId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Düzenle">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    <a href="/Rentals/CancelRental/@item.RentalId" onclick="return confirm('Kiralama sözleşmesini iptal etmek istediğinize emin misiniz?');" class="p-1.5 rounded-lg text-secondary hover:text-error hover:bg-error-container/30 transition-colors" title="İptal Et">
                                        <span class="material-symbols-outlined text-[18px]">cancel</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="py-12 text-center text-secondary">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[40px] text-outline">key</span>
                                <p class="font-medium text-sm text-on-surface">Kayıtlı kiralama sözleşmesi bulunamadı.</p>
                                <p class="text-xs text-outline">Filodaki araçlar için yeni bir rezervasyon veya anlık kiralama oluşturabilirsiniz.</p>
                                <a href="/Rentals/CreateRental" class="mt-2 inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-primary-container text-on-primary text-xs font-semibold">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Yeni Kiralama Oluştur
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Sayfalama ve Alt Özet -->
    <div class="p-4 sm:p-5 border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary">
        <div>
            Toplam <span class="font-bold text-on-surface">@(Model?.Count ?? 0)</span> sözleşmeden <span class="font-semibold text-on-surface">1 - @(Model?.Count ?? 0)</span> arası gösteriliyor
        </div>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 rounded-md border border-outline-variant text-outline hover:bg-surface-container-low transition-colors disabled:opacity-50" disabled>Önceki</button>
            <button class="px-3 py-1.5 rounded-md bg-primary-container text-on-primary font-semibold">1</button>
            <button class="px-3 py-1.5 rounded-md border border-outline-variant hover:bg-surface-container-low transition-colors">Sonraki</button>
        </div>
    </div>

</div>

<!-- Operasyonel Süreç Bilgilendirme Kartı -->
<div class="mt-6 bg-surface-container-low border border-outline-variant rounded-xl p-5 flex items-start gap-4">
    <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0">
        <span class="material-symbols-outlined text-[20px]">verified_user</span>
    </div>
    <div>
        <div class="flex items-center gap-2 mb-1">
            <h4 class="text-sm font-semibold text-on-surface">Operasyonel Entegrasyon & KABİS Bildirimi</h4>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-surface-container text-primary">KABİS AUTO-SYNC</span>
        </div>
        <p class="text-xs text-secondary leading-relaxed">
            Aktif veya devam eden statüdeki tüm kiralama sözleşmeleri, TC Emniyet Genel Müdürlüğü KABİS (Kiralık Araç Bildirim Sistemi) servisi ile anlık olarak senkronize edilir. Araç teslim ve iade protokolleri ilgili şubelerce tutanak ile kayıt altına alınır.
        </p>
    </div>
</div>
