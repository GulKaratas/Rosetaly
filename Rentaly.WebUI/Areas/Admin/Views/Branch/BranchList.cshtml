@model List<ResultBranchDto>
@{
    ViewData["Title"] = "BranchList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Şubeler", "Şirketin hizmet verdiği tüm şube lokasyonları ve yönetim listesi", "Şubeler", "/Admin/Branch/CreateBranch/", "Yeni Şube Ekle", false, ""))
}

<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">
    <div class="p-4 sm:p-5 border-b border-outline-variant bg-surface-container-lowest flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1 max-w-md relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input type="text" id="branchSearchInput" placeholder="Şube adı, şehir veya adres ara..."
                   class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
        </div>

        <div class="flex items-center gap-3 flex-wrap">
            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="">Tüm Şehirler</option>
                @foreach (var city in Model.Select(x => x.City).Distinct())
                {
                    <option value="@city">@city</option>
                }
            </select>

            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="name-asc">Sırala: Şube Adı (A - Z)</option>
                <option value="name-desc">Sırala: Şube Adı (Z - A)</option>
                <option value="id-desc">Son Eklenenler</option>
                <option value="city-asc">Şehre Göre</option>
            </select>

            <button type="button" class="p-2 rounded-lg border border-outline-variant text-secondary hover:text-on-surface hover:bg-surface-container-low transition-colors" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[20px]">restart_alt</span>
            </button>
        </div>
    </div>

    <div class="overflow-x-auto w-full">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant text-secondary text-[12px] uppercase tracking-wider font-semibold">
                    <th class="py-3.5 px-4 w-12 text-center">
                        <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                    </th>
                    <th class="py-3.5 px-4 w-20">ID</th>
                    <th class="py-3.5 px-4">Şube Adı</th>
                    <th class="py-3.5 px-4">Şehir</th>
                    <th class="py-3.5 px-4 min-w-[240px]">Açık Adres</th>
                    <th class="py-3.5 px-4">Durum</th>
                    <th class="py-3.5 px-4 text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant text-sm">
                @if (Model.Count > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-3.5 px-4 text-center">
                                <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                            </td>
                            <td class="py-3.5 px-4 font-mono text-xs text-secondary font-semibold">
                                #@item.BranchId.ToString("D2")
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-lg bg-primary/10 text-primary border border-outline-variant flex items-center justify-center shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">store</span>
                                    </div>
                                    <div>
                                        <span class="font-bold text-on-surface block text-sm">@item.BranchName</span>
                                        <span class="text-[11px] text-outline font-mono">BRN-@item.BranchId.ToString("D4")</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-surface-container text-primary border border-outline-variant">
                                    <span class="material-symbols-outlined text-[14px]">pin_drop</span>
                                    @item.City
                                </span>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-start gap-1.5 text-xs text-on-surface max-w-sm">
                                    <span class="material-symbols-outlined text-[14px] text-secondary mt-0.5">location_on</span>
                                    <span class="line-clamp-2" title="@item.Address">@item.Address</span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    Aktif
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="inline-flex items-center gap-1">
                                    <a href="/Admin/Branch/UpdateBranch/@item.BranchId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Düzenle">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    <form asp-area="Admin" asp-controller="Branch" asp-action="DeleteBranch" asp-route-id="@item.BranchId" method="post" class="inline" onsubmit="return confirm('@item.BranchName şubesini silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="p-1.5 rounded-lg text-secondary hover:text-error hover:bg-error-container/30 transition-colors" title="Sil">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-secondary">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[40px] text-outline">store</span>
                                <p class="font-medium text-sm text-on-surface">Kayıtlı şube bulunamadı.</p>
                                <p class="text-xs text-outline">Henüz bir şube tanımlanmamış. İlk şubenizi ekleyebilirsiniz.</p>
                                <a href="/Admin/Branch/CreateBranch" class="mt-2 inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-primary-container text-on-primary text-xs font-semibold">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Yeni Şube Ekle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-4 sm:p-5 border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary">
        <div>
            Toplam <span class="font-bold text-on-surface">@Model.Count</span> şubeden <span class="font-semibold text-on-surface">1 - @Model.Count</span> arası gösteriliyor
        </div>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 rounded-md border border-outline-variant text-outline hover:bg-surface-container-low transition-colors disabled:opacity-50" disabled>Önceki</button>
            <button class="px-3 py-1.5 rounded-md bg-primary-container text-on-primary font-semibold">1</button>
            <button class="px-3 py-1.5 rounded-md border border-outline-variant hover:bg-surface-container-low transition-colors">Sonraki</button>
        </div>
    </div>
</div>
