@model CreateBranchDto
@{
    ViewData["Title"] = "Yeni Şube Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", (
        "Yeni Şube Ekle",
        "Sisteme yeni bir hizmet noktası veya şube tanımlayın.",
        "Şubeler",
        "",
        "Listeye Dön",
        true,
        "/Admin/Branch/BranchList"
    ))
}

<form asp-area="Admin" asp-controller="Branch" asp-action="CreateBranch" method="post" class="flex flex-col w-full space-y-space-lg" id="createBranchForm">
    @Html.AntiForgeryToken()

    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-lg">
        <div class="flex items-center justify-between pb-space-md mb-space-lg border-b border-outline-variant">
            <div class="flex items-center gap-space-sm">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">storefront</span>
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">Şube Kimliği</h2>
                    <p class="font-body-sm text-body-sm text-secondary">Müşterilerin rezervasyonda göreceği resmi ofis adı ve şehir.</p>
                </div>
            </div>
            <span class="font-table-header text-table-header uppercase text-secondary bg-surface-container-low px-space-sm py-1 rounded">
                Zorunlu Alanlar
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="BranchName">
                    Şube Adı <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="BranchName" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="text" placeholder="Örn: İstanbul Kadıköy Şubesi" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-secondary text-[18px]">hub</span>
                </div>
                <span asp-validation-for="BranchName" class="text-error text-[11px]"></span>
            </div>

            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="City">
                    Şehir <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="City" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="text" placeholder="Örn: İstanbul" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-secondary text-[18px]">location_on</span>
                </div>
                <span asp-validation-for="City" class="text-error text-[11px]"></span>
            </div>
        </div>
    </div>

    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-lg">
        <div class="flex items-center justify-between pb-space-md mb-space-lg border-b border-outline-variant">
            <div class="flex items-center gap-space-sm">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">pin_drop</span>
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">Konum ve Açık Adres</h2>
                    <p class="font-body-sm text-body-sm text-secondary">Sözleşme, fatura ve yönlendirmede kullanılacak tam adres.</p>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-space-xs">
            <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="Address">
                Açık Adres <span class="text-error">*</span>
            </label>
            <div class="relative">
                <textarea asp-for="Address" rows="3" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm pr-12 font-body-md text-body-md text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant resize-y" required placeholder="Mahalle, cadde, no ve ilçe"></textarea>
                <span class="material-symbols-outlined absolute right-space-md top-space-sm text-secondary text-[18px]">map</span>
            </div>
            <span asp-validation-for="Address" class="text-error text-[11px]"></span>
        </div>
    </div>

    <div class="bg-surface-container rounded-xl p-space-md flex items-start gap-space-md">
        <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-[22px]">account_tree</span>
        </div>
        <div class="flex flex-col gap-space-xs">
            <div class="flex items-center gap-space-xs">
                <h3 class="font-headline-md text-headline-md text-on-surface">Şube ve Araç İlişkisi</h3>
                <span class="px-2 py-0.5 rounded-full bg-surface-container-lowest font-table-header text-table-header text-primary font-semibold">1 : N</span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                Kaydedilen şube, araç ekleme ekranındaki <span class="font-semibold text-on-surface">bağlı şube</span> listesine eklenir.
                Filo kayıtları bu şube üzerinden tutulur.
            </p>
        </div>
    </div>

    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-md flex flex-col sm:flex-row items-center justify-between gap-space-md">
        <div class="flex items-center gap-space-xs text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-tertiary text-[20px]">check_circle</span>
            <span>Yeni şube kaydı anında veritabanına işlenecektir.</span>
        </div>
        <div class="flex items-center gap-space-sm w-full sm:w-auto justify-end">
            <a href="/Admin/Branch/BranchList" class="px-space-lg py-space-sm rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-nav-item text-label-nav-item transition-colors text-center">
                Vazgeç
            </a>
            <button type="submit" class="flex items-center justify-center gap-space-xs px-space-xl py-space-sm rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-nav-item text-label-nav-item shadow-sm transition-all">
                <span class="material-symbols-outlined text-[20px]">add_task</span>
                <span>Şubeyi Kaydet</span>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
