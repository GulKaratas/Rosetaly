@using Rentaly.DtoLayer.About
@model CreateAboutDto
@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Hakkımızda İçeriği Ekle", "Sitede görünecek kurumsal başlık, görsel ve açıklama metinlerini girin.", "Site İçeriği", "", "Listeye Dön", true, "/Admin/About/AboutList/"))
}

<form asp-area="Admin" asp-controller="About" asp-action="CreateAbout" method="post" class="flex flex-col gap-gutter">

    <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>

    <!-- Card 1: Temel kurumsal tanıtım bilgileri -->
    <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pb-space-xs">
            <div class="flex items-center gap-space-sm">
                <div class="w-8 h-8 rounded-lg bg-primary-fixed flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">corporate_fare</span>
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">Temel Kurumsal Tanıtım Bilgileri</h2>
                    <span class="font-table-header text-table-header text-secondary uppercase tracking-wider">Tanıtım ve Ana Başlık</span>
                </div>
            </div>
            <span class="font-label-badge text-label-badge text-outline">* Zorunlu Alanlar</span>
        </div>

        <!-- Hızlı doldur şablonları -->
        <div class="bg-surface-container-low rounded-lg p-space-sm flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
            <div class="flex items-center gap-space-xs text-secondary font-label-badge text-label-badge">
                <span class="material-symbols-outlined text-[16px] text-primary">auto_fix_high</span>
                <span>Hızlı Doldur Şablonları:</span>
            </div>
            <div class="flex flex-wrap items-center gap-space-xs">
                <button class="px-space-sm py-1 rounded bg-surface-container-lowest hover:bg-primary hover:text-on-primary text-secondary font-label-badge text-label-badge transition-all shadow-sm" onclick="applyTemplate('corporate')" type="button">
                    Kurumsal &amp; Filo
                </button>
                <button class="px-space-sm py-1 rounded bg-surface-container-lowest hover:bg-primary hover:text-on-primary text-secondary font-label-badge text-label-badge transition-all shadow-sm" onclick="applyTemplate('luxury')" type="button">
                    Lüks &amp; Prestij
                </button>
                <button class="px-space-sm py-1 rounded bg-surface-container-lowest hover:bg-primary hover:text-on-primary text-secondary font-label-badge text-label-badge transition-all shadow-sm" onclick="applyTemplate('budget')" type="button">
                    Ekonomik &amp; Güvenilir
                </button>
            </div>
        </div>

        <!-- Başlık -->
        <div class="flex flex-col gap-space-xs">
            <label asp-for="Title" class="font-label-nav-item text-label-nav-item text-on-surface font-semibold flex items-center justify-between">
                <span>Kurumsal Başlık (Title) <span class="text-error">*</span></span>
                <span class="font-table-header text-table-header text-secondary font-normal" id="titleLengthHint">0 / 120 Karakter</span>
            </label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">title</span>
                <input asp-for="Title" maxlength="120"
                       class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest transition-colors shadow-sm"
                       placeholder="Örn: Türkiye'nin En Güvenilir ve Yenilikçi Araç Kiralama Deneyimi" />
            </div>
            <span asp-validation-for="Title" class="text-error font-body-sm text-body-sm"></span>
        </div>

        <!-- Açıklama -->
        <div class="flex flex-col gap-space-xs">
            <label asp-for="Description" class="font-label-nav-item text-label-nav-item text-on-surface font-semibold flex items-center justify-between">
                <span>Detaylı Tanıtım Açıklaması (Description) <span class="text-error">*</span></span>
                <span class="font-table-header text-table-header text-secondary font-normal" id="descCounter">0 / 600 Karakter</span>
            </label>
            <textarea asp-for="Description" rows="4" maxlength="600"
                      class="w-full p-3 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest transition-colors shadow-sm resize-none"
                      placeholder="RentAdmin olarak 2012 yılından bu yana bireysel ve kurumsal kiralama çözümlerinde müşteri memnuniyetini en üst seviyede tutuyoruz..."></textarea>
            <span asp-validation-for="Description" class="text-error font-body-sm text-body-sm"></span>
        </div>
    </div>

    <!-- Card 2: Avantaj kartları -->
    <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
        <div class="flex items-center gap-space-sm pb-space-xs">
            <div class="w-8 h-8 rounded-lg bg-tertiary-fixed flex items-center justify-center text-tertiary">
                <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
            </div>
            <div>
                <h2 class="font-headline-md text-headline-md text-on-surface">Öne Çıkan Değerler &amp; Avantaj Kartları</h2>
                <span class="font-table-header text-table-header text-secondary uppercase tracking-wider">İki Temel Rekabet Gücü &amp; Güven Unsuru</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter-sm mt-space-xs">

            <!-- Avantaj 1 -->
            <div class="p-space-md rounded-xl bg-surface-container-low flex flex-col gap-space-sm relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-badge text-label-badge flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">looks_one</span>
                        1. Avantaj Bloğu
                    </span>
                    <span class="material-symbols-outlined text-primary text-[20px]">support_agent</span>
                </div>

                <div class="flex flex-col gap-space-xs">
                    <label asp-for="FirstAdvantageTitle" class="font-label-nav-item text-label-nav-item text-on-surface font-semibold">
                        1. Avantaj Başlığı <span class="text-error">*</span>
                    </label>
                    <input asp-for="FirstAdvantageTitle"
                           class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none shadow-sm"
                           placeholder="Örn: 7/24 Kesintisiz Yol Desteği" />
                    <span asp-validation-for="FirstAdvantageTitle" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-space-xs">
                    <label asp-for="FirstAdvantageDescription" class="font-label-nav-item text-label-nav-item text-on-surface font-semibold">
                        1. Avantaj Açıklaması <span class="text-error">*</span>
                    </label>
                    <textarea asp-for="FirstAdvantageDescription" rows="2"
                              class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none shadow-sm resize-none"
                              placeholder="Türkiye genelinde tüm yolculuklarınızda anında çekici ve ikame araç güvencesi."></textarea>
                    <span asp-validation-for="FirstAdvantageDescription" class="text-error font-body-sm text-body-sm"></span>
                </div>
            </div>

            <!-- Avantaj 2 -->
            <div class="p-space-md rounded-xl bg-surface-container-low flex flex-col gap-space-sm relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed-variant font-label-badge text-label-badge flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">looks_two</span>
                        2. Avantaj Bloğu
                    </span>
                    <span class="material-symbols-outlined text-tertiary text-[20px]">price_check</span>
                </div>

                <div class="flex flex-col gap-space-xs">
                    <label asp-for="SecondAdvantageTitle" class="font-label-nav-item text-label-nav-item text-on-surface font-semibold">
                        2. Avantaj Başlığı <span class="text-error">*</span>
                    </label>
                    <input asp-for="SecondAdvantageTitle"
                           class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none shadow-sm"
                           placeholder="Örn: Sıfır Gizli Ücret &amp; Şeffaf Fiyat" />
                    <span asp-validation-for="SecondAdvantageTitle" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-space-xs">
                    <label asp-for="SecondAdvantageDescription" class="font-label-nav-item text-label-nav-item text-on-surface font-semibold">
                        2. Avantaj Açıklaması <span class="text-error">*</span>
                    </label>
                    <textarea asp-for="SecondAdvantageDescription" rows="2"
                              class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md placeholder:text-outline focus:outline-none shadow-sm resize-none"
                              placeholder="Sözleşmede ne gördüyseniz o; depozito iadesi ve faturalandırmada tam şeffaflık."></textarea>
                    <span asp-validation-for="SecondAdvantageDescription" class="text-error font-body-sm text-body-sm"></span>
                </div>
            </div>
        </div>

        <!-- Kaydet / Vazgeç -->
        <div class="flex items-center justify-end gap-space-sm pt-space-md mt-space-xs">
            <a asp-area="Admin" asp-controller="About" asp-action="AboutList"
               class="px-space-lg py-2.5 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container font-label-nav-item text-label-nav-item transition-all">
                Vazgeç
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-space-xs px-space-xl py-2.5 rounded-lg bg-primary-container text-on-primary hover:bg-primary font-label-nav-item text-label-nav-item font-semibold shadow-md transition-all">
                <span class="material-symbols-outlined text-[18px]">add_task</span>
                <span>İçeriği Kaydet</span>
            </button>
        </div>
    </div>

    <!-- Card 3: Bilgilendirme -->
    <div class="bg-surface-container rounded-xl p-space-md flex items-start gap-space-md">
        <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-[22px]">public</span>
        </div>
        <div class="flex flex-col gap-space-xs">
            <div class="flex items-center gap-space-xs">
                <h3 class="font-headline-md text-headline-md text-on-surface">Entity &amp; Vitrin Entegrasyon Bildirimi</h3>
                <span class="px-2 py-0.5 rounded-full bg-surface-container-lowest font-table-header text-table-header text-primary font-semibold">Aktif Görünüm</span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                Kaydedilen bilgiler web arayüzünde <span class="font-semibold text-on-surface">"Biz Kimiz / Hakkımızda"</span> ana bileşeni olarak işlenir.
                Title ve Description genel kurum vizyonunu temsil ederken, iki avantaj öğesi görsel rozetler eşliğinde yan yana ziyaretçilere güven aşılar.
            </p>
        </div>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const $ = id => document.getElementById(id);

            const fields = {
                Title: $('Title'),
                Description: $('Description'),
                FirstAdvantageTitle: $('FirstAdvantageTitle'),
                FirstAdvantageDescription: $('FirstAdvantageDescription'),
                SecondAdvantageTitle: $('SecondAdvantageTitle'),
                SecondAdvantageDescription: $('SecondAdvantageDescription')
            };

            const titleHint = $('titleLengthHint');
            const descCounter = $('descCounter');

            const templates = {
                corporate: {
                    Title: "Kurumsal Filo Kiralama Çözümlerinde Güvenilir Partneriniz",
                    Description: "RentAdmin olarak şirketinizin tüm mobilite ihtiyaçlarını optimize ediyoruz. Geniş operasyonel araç portföyümüz, dönemsel kiralama esnekliği ve periyodik servis ağımızla sermayenizi işinize yönlendirmenizi sağlıyoruz.",
                    FirstAdvantageTitle: "Hızlı İkame Araç Tedariki",
                    FirstAdvantageDescription: "Olası teknik arızalarda en geç 2 saat içinde eşdeğer segment araç kapınızda.",
                    SecondAdvantageTitle: "Tam Vergi & Gider Avantajı",
                    SecondAdvantageDescription: "Operasyonel kiralama faturaları ile maliyetlerinizi amortisman yükü olmadan muhasebeleştirin."
                },
                luxury: {
                    Title: "Prestij, Konfor ve Kusursuz VIP Sürüş Ayrıcalığı",
                    Description: "Özel günleriniz, transferleriniz veya üst düzey iş toplantılarınız için en yeni model lüks sedan ve SUV araç filomuzla hizmetinizdeyiz. Kişiye özel ayrıcalıklarla seyahatin keyfini çıkarın.",
                    FirstAdvantageTitle: "Özel Şoför & VIP Karşılama",
                    FirstAdvantageDescription: "Havalimanı ve otel transferlerinizde çok dilli uzman protokol şoför kadrosu.",
                    SecondAdvantageTitle: "Üst Segment Donanım",
                    SecondAdvantageDescription: "Tüm araçlarımız sıfır kondisyonda, full opsiyonlu ve özel iç temizlik sertifikalıdır."
                },
                budget: {
                    Title: "Şehrin En Uygun ve Güvenilir Günlük Kiralama Portföyü",
                    Description: "Bütçenizi sarsmayan fiyat politikası, sürpriz maliyet barındırmayan şeffaf sözleşmeler ve şehir merkezlerinde hızlı teslimat noktaları ile yolculuklarınıza değer katıyoruz.",
                    FirstAdvantageTitle: "Ekonomik Yakıt Tüketimli Araçlar",
                    FirstAdvantageDescription: "Yeni nesil hibrit ve dizel seçeneklerle kilometre başına en düşük yakıt harcaması.",
                    SecondAdvantageTitle: "Anında Depozito İadesi",
                    SecondAdvantageDescription: "Araç teslimi sonrasında provizyon bloke bedeliniz aynı gün kredi kartınıza geri yansıtılır."
                }
            };

            function updateCounters() {
                titleHint.textContent = `${fields.Title.value.length} / ${fields.Title.maxLength} Karakter`;
                descCounter.textContent = `${fields.Description.value.length} / ${fields.Description.maxLength} Karakter`;
            }

            window.applyTemplate = function (key) {
                const template = templates[key];
                if (!template) return;

                Object.keys(fields).forEach(name => {
                    fields[name].value = template[name];
                });
                updateCounters();
            };

            fields.Title.addEventListener('input', updateCounters);
            fields.Description.addEventListener('input', updateCounters);

            updateCounters();
        })();
    </script>
}