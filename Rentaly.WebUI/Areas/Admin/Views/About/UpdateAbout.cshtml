@using Rentaly.DtoLayer.About
@model UpdateAboutDto
@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", (
        "Hakkımızda Güncelle",
        "Web sitesinde yer alan kurumsal tanıtım metnini ve avantaj kartlarını düzenleyin.",
        "Site İçeriği",
        "/Admin/About/AboutList/",
        "Listeye Dön",
        true,
        ""
    ))
}

<form asp-action="UpdateAbout" method="post" id="UpdateAbout">
    <!-- Model Binding için Gizli ID -->
    <input type="hidden" asp-for="AboutId" />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Sol & Orta Sütun: Form Alanları (2 Kolon) -->
        <div class="lg:col-span-2 flex flex-col gap-6">
            
            <!-- 1. Temel Kurumsal Tanıtım Bilgileri Kartı -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-outline-variant">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-primary-container/10 text-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-[20px]">corporate_fare</span>
                        </div>
                        <div>
                            <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Temel Kurumsal Tanıtım Bilgileri</h2>
                            <p class="text-body-sm text-secondary mt-0.5">Ana başlık ve ziyaretçilere güven aşılayan kurumsal vizyon metni</p>
                        </div>
                    </div>
                    <span class="text-xs text-secondary">Zorunlu Alanlar (*)</span>
                </div>

                <div class="flex flex-col gap-5">
                    <!-- Kurumsal Başlık (Title) -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider" asp-for="Title">
                                Kurumsal Başlık <span class="text-error">*</span>
                            </label>
                            <span class="text-xs text-outline font-mono" id="titleCharCount">@Model.Title?.Length / 120 Karakter</span>
                        </div>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">title</span>
                            <input asp-for="Title" type="text" required id="inputTitle"
                                   class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
                        </div>
                        <span asp-validation-for="Title" class="text-error text-xs mt-1 block"></span>
                        <p class="text-[11px] text-secondary mt-1">Web sitesinde 'Hakkımızda' ana başlığı olarak H1/H2 hiyerarşisinde görüntülenir.</p>
                    </div>

                    <!-- Detaylı Tanıtım Açıklaması (Description) -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider" asp-for="Description">
                                Tanıtım & Vizyon Açıklaması <span class="text-error">*</span>
                            </label>
                            <span class="text-xs text-outline font-mono" id="descCharCount">@Model.Description?.Length / 600 Karakter</span>
                        </div>
                        <div class="relative">
                            <textarea asp-for="Description" rows="5" maxlength="600" required id="inputDescription"
                                      class="w-full p-3.5 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all resize-none leading-relaxed">@Model.Description</textarea>
                        </div>
                        <span asp-validation-for="Description" class="text-error text-xs mt-1 block"></span>
                        <p class="text-[11px] text-secondary mt-1">Şirket vizyonu, tecrübe yılı ve kurumsal güven taahhüdünü belirten ana metin paragrafı.</p>
                    </div>
                </div>
            </div>

            <!-- 2. Öne Çıkan Değerler & Avantaj Kartları Kartı -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-outline-variant">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-primary-container/10 text-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-[20px]">stars</span>
                        </div>
                        <div>
                            <h2 class="text-headline-md font-headline-md text-on-surface font-semibold">Öne Çıkan Değerler & Avantaj Kartları</h2>
                            <p class="text-body-sm text-secondary mt-0.5">Web sitesinde vitrine çıkarılacak iki ayrıcalıklı kurumsal parametre</p>
                        </div>
                    </div>
                    <span class="text-xs text-secondary">Vitrinde Yan Yana Listelenir</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    
                    <!-- 1. AVANTAJ BLOKU -->
                    <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant flex flex-col gap-4">
                        <div class="flex items-center justify-between pb-2 border-b border-outline-variant">
                            <div class="flex items-center gap-2">
                                <span class="w-6 h-6 rounded-md bg-primary text-on-primary text-xs font-bold flex items-center justify-center font-mono">01</span>
                                <h3 class="text-xs font-bold text-on-surface uppercase tracking-wider">1. Avantaj Parametresi</h3>
                            </div>
                            <span class="material-symbols-outlined text-primary text-[18px]">verified</span>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="FirstAdvantageTitle">
                                Avantaj Başlığı (1) <span class="text-error">*</span>
                            </label>
                            <input asp-for="FirstAdvantageTitle" type="text" required id="inputAdv1Title"
                                   class="w-full px-3.5 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary transition-all" />
                            <span asp-validation-for="FirstAdvantageTitle" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="FirstAdvantageDescription">
                                Açıklama Metni (1) <span class="text-error">*</span>
                            </label>
                            <textarea asp-for="FirstAdvantageDescription" rows="3" maxlength="200" required id="inputAdv1Desc"
                                      class="w-full p-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-xs text-on-surface focus:outline-none focus:border-primary transition-all resize-none leading-relaxed">@Model.FirstAdvantageDescription</textarea>
                            <span asp-validation-for="FirstAdvantageDescription" class="text-error text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <!-- 2. AVANTAJ BLOKU -->
                    <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant flex flex-col gap-4">
                        <div class="flex items-center justify-between pb-2 border-b border-outline-variant">
                            <div class="flex items-center gap-2">
                                <span class="w-6 h-6 rounded-md bg-primary text-on-primary text-xs font-bold flex items-center justify-center font-mono">02</span>
                                <h3 class="text-xs font-bold text-on-surface uppercase tracking-wider">2. Avantaj Parametresi</h3>
                            </div>
                            <span class="material-symbols-outlined text-primary text-[18px]">verified</span>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="SecondAdvantageTitle">
                                Avantaj Başlığı (2) <span class="text-error">*</span>
                            </label>
                            <input asp-for="SecondAdvantageTitle" type="text" required id="inputAdv2Title"
                                   class="w-full px-3.5 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary transition-all" />
                            <span asp-validation-for="SecondAdvantageTitle" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1.5" asp-for="SecondAdvantageDescription">
                                Açıklama Metni (2) <span class="text-error">*</span>
                            </label>
                            <textarea asp-for="SecondAdvantageDescription" rows="3" maxlength="200" required id="inputAdv2Desc"
                                      class="w-full p-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-xs text-on-surface focus:outline-none focus:border-primary transition-all resize-none leading-relaxed">@Model.SecondAdvantageDescription</textarea>
                            <span asp-validation-for="SecondAdvantageDescription" class="text-error text-xs mt-1 block"></span>
                        </div>
                    </div>

                </div>

                <!-- Alt Aksiyon & Bilgilendirme -->
                <div class="flex items-center justify-between pt-6 mt-6 border-t border-outline-variant">
                    <span class="text-xs text-secondary flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-emerald-600 text-[16px]">check_circle</span>
                        Tüm alanlar veritabanı kural setine uygundur.
                    </span>
                    <div class="flex items-center gap-3">
                        <a href="/Abouts" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container-low text-sm font-medium transition-colors">
                            Vazgeç
                        </a>
                        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-primary-container text-on-primary font-semibold text-sm shadow-sm hover:bg-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">save</span>
                            Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Sağ Sütun: Kayıt Meta Bilgileri & Entegrasyon Rehberi (Canlı Önizlemesiz) -->
        <div class="flex flex-col gap-6">
            
            <!-- 1. Kayıt Detayları Kartı -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 shadow-sm space-y-3.5">
                <div class="flex items-center justify-between pb-3 border-b border-outline-variant">
                    <span class="text-xs font-semibold uppercase tracking-wider text-secondary">Kayıt Detayları</span>
                    <span class="material-symbols-outlined text-outline text-[18px]">badge</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-secondary">Kayıt ID:</span>
                    <span class="font-mono text-primary font-bold">#ABT-@Model.AboutId.ToString("D3")</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-secondary">Yayın Durumu:</span>
                    <span class="inline-flex items-center gap-1 font-semibold text-emerald-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Aktif / Vitrinde
                    </span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-secondary">Oluşturulma:</span>
                    <span class="font-medium text-on-surface">15 Mart 2024, 09:15</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-secondary">Son Güncelleme:</span>
                    <span class="font-medium text-on-surface">@DateTime.Now.ToString("dd MMMM yyyy, HH:mm")</span>
                </div>
                <div class="flex items-center justify-between text-xs pt-1 border-t border-outline-variant">
                    <span class="text-secondary">Son İşlem Yapan:</span>
                    <span class="font-medium text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px] text-secondary">account_circle</span>
                        Sistem Yöneticisi
                    </span>
                </div>
            </div>

            <!-- 2. Web Sitesi Entegrasyon Notu -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 shadow-sm">
                <div class="flex items-center gap-2 mb-3 text-primary">
                    <span class="material-symbols-outlined text-[20px]">sync</span>
                    <h4 class="text-sm font-semibold text-on-surface">Web Sitesi Entegrasyon Notu</h4>
                </div>
                <p class="text-xs text-secondary leading-relaxed mb-3">
                    Müşteri arayüzündeki <strong>Hakkımızda (About)</strong> bileşeni, veritabanından doğrudan bu tekil ana kaydı çağırır. Burada yapılan başlık veya avantaj güncellemeleri, CDN önbelleği temizlendikten sonra (ortalama 30 sn) ziyaretçilere otomatik yansıtılır.
                </p>
                <div class="p-2.5 rounded-lg bg-surface-container-low border border-outline-variant/80 text-[11px] text-primary font-medium flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">bolt</span>
                    Canlı Önbellek Aktif (In-Memory)
                </div>
            </div>

            <!-- 3. Sistem Standartları Rehberi -->
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 shadow-sm">
                <div class="flex items-center gap-2 mb-3 text-secondary">
                    <span class="material-symbols-outlined text-[20px]">tune</span>
                    <h4 class="text-sm font-semibold text-on-surface">Sistem Standartları</h4>
                </div>
                <ul class="text-xs text-secondary space-y-2.5 leading-relaxed">
                    <li class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-primary text-[15px] shrink-0 mt-0.5">check</span>
                        <span><strong>Tekil Vitrin Prensibi:</strong> Sistemde yalnız 1 aktif hakkımızda kaydı yayında kalır.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-primary text-[15px] shrink-0 mt-0.5">check</span>
                        <span><strong>SEO Başlığı:</strong> Arama motoru optimizasyonu için başlığın 40-70 karakter aralığında kalması önerilir.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-primary text-[15px] shrink-0 mt-0.5">check</span>
                        <span><strong>Mobil Uyum:</strong> Avantaj kartları mobil cihazlarda dikey istifleneceği için kısa ve öz tutulmalıdır.</span>
                    </li>
                </ul>
            </div>

        </div>

    </div>
</form>

<script>
    const titleInput = document.getElementById('inputTitle');
    const descInput = document.getElementById('inputDescription');
    const titleCharCount = document.getElementById('titleCharCount');
    const descCharCount = document.getElementById('descCharCount');

    titleInput?.addEventListener('input', () => {
        if (titleCharCount) titleCharCount.textContent = `${titleInput.value.length} / 120 Karakter`;
    });

    descInput?.addEventListener('input', () => {
        if (descCharCount) descCharCount.textContent = `${descInput.value.length} / 600 Karakter`;
    });
</script>


