@using Rentaly.DtoLayer.About

@model List<ResultAboutDto>
@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Hakkımızda", "Web sitesinde yer alan kurumsal hakkımızda metni ve içerik yönetimi", "Site İçeriği", "/Admin/About/CreateAbout/", "Yeni İçerik Ekle", false, ""))
}


<!-- Ana Yönetim Kartı & Tablo -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">
    
    <!-- Filtreleme ve Arama Çubuğu -->
    <div class="p-4 sm:p-5 border-b border-outline-variant bg-surface-container-lowest flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1 max-w-md relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input type="text" id="aboutSearchInput" placeholder="Başlık veya avantaj metinlerinde ara..."
                   class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
        </div>
        
        <div class="flex items-center gap-3 flex-wrap">
            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="">Tüm Yayın Durumları</option>
                <option value="active">Ana Sayfada Yayında</option>
                <option value="draft">Taslak İçerikler</option>
            </select>

            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="id-desc">Son Güncellenenler</option>
                <option value="title-asc">Başlığa Göre (A - Z)</option>
                <option value="title-desc">Başlığa Göre (Z - A)</option>
            </select>

            <button type="button" class="p-2 rounded-lg border border-outline-variant text-secondary hover:text-on-surface hover:bg-surface-container-low transition-colors" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[20px]">restart_alt</span>
            </button>
        </div>
    </div>

    <!-- Veri Tablosu -->
    <div class="overflow-x-auto w-full">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant text-secondary text-[12px] uppercase tracking-wider font-semibold">
                    <th class="py-3.5 px-4 w-12 text-center">
                        <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                    </th>
                    <th class="py-3.5 px-4 w-16">ID</th>
                    <th class="py-3.5 px-4 min-w-[280px]">KURUMSAL BAŞLIK & VİTRİN METNİ</th>
                    <th class="py-3.5 px-4 min-w-[220px]">1. AVANTAJ (DEĞER 1)</th>
                    <th class="py-3.5 px-4 min-w-[220px]">2. AVANTAJ (DEĞER 2)</th>
                    <th class="py-3.5 px-4">VİTRİN DURUMU</th>
                    <th class="py-3.5 px-4 text-right">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant text-sm">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-3.5 px-4 text-center">
                                <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                            </td>
                            <td class="py-3.5 px-4 font-mono text-xs text-secondary font-semibold">
                                #@item.AboutId.ToString("D2")
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-start gap-3">
                                    <div class="w-9 h-9 rounded-lg bg-primary-container/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                                        <span class="material-symbols-outlined text-[20px]">corporate_fare</span>
                                    </div>
                                    <div class="min-w-0">
                                        <span class="font-bold text-on-surface block text-sm leading-snug">@item.Title</span>
                                        <p class="text-xs text-secondary line-clamp-2 mt-1 leading-relaxed" title="@item.Description">
                                            @item.Description
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="p-2.5 rounded-lg bg-surface-container border border-outline-variant">
                                    <div class="flex items-center gap-1.5 font-semibold text-xs text-on-surface mb-0.5">
                                        <span class="material-symbols-outlined text-primary text-[15px]">verified</span>
                                        <span class="truncate">@item.FirstAdvantageTitle</span>
                                    </div>
                                    <p class="text-[11px] text-secondary line-clamp-2 leading-relaxed" title="@item.FirstAdvantageDescription">
                                        @item.FirstAdvantageDescription
                                    </p>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="p-2.5 rounded-lg bg-surface-container border border-outline-variant">
                                    <div class="flex items-center gap-1.5 font-semibold text-xs text-on-surface mb-0.5">
                                        <span class="material-symbols-outlined text-primary text-[15px]">verified</span>
                                        <span class="truncate">@item.SecondAdvantageTitle</span>
                                    </div>
                                    <p class="text-[11px] text-secondary line-clamp-2 leading-relaxed" title="@item.SecondAdvantageDescription">
                                        @item.SecondAdvantageDescription
                                    </p>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    Yayında / Vitrin
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="inline-flex items-center gap-1">
                                    <a href="/Admin/About/UpdateAbout/@item.AboutId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Düzenle">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                   <form asp-area="Admin" asp-controller="About" asp-action="DeleteAbout" asp-route-id="@item.AboutId" method="post" class="inline" onsubmit="return confirm('Hakkımızda içeriğini silmek istediğinize emin misiniz? Ana sayfadaki tanıtım alanı boş kalabilir.');">
            <button type="submit" class="p-1.5 rounded-lg text-secondary hover:text-error hover:bg-error-container/30 transition-colors" title="Sil">
                <span class="material-symbols-outlined text-[18px]">delete</span>
            </button>
        </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-secondary">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[40px] text-outline">corporate_fare</span>
                                <p class="font-medium text-sm text-on-surface">Kayıtlı hakkımızda içeriği bulunamadı.</p>
                                <p class="text-xs text-outline">Web sitenizde gösterilmek üzere kurumsal tanıtım ve 2 temel avantajınızı ekleyebilirsiniz.</p>
                                <a href="/Abouts/CreateAbout" class="mt-2 inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-primary-container text-on-primary text-xs font-semibold">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Yeni İçerik Ekle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Sayfalama ve Alt Özet -->
    <div class="p-4 sm:p-5 border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary">
        <div>
            Toplam <span class="font-bold text-on-surface">@(Model?.Count ?? 0)</span> içerikten <span class="font-semibold text-on-surface">1 - @(Model?.Count ?? 0)</span> arası gösteriliyor
        </div>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 rounded-md border border-outline-variant text-outline hover:bg-surface-container-low transition-colors disabled:opacity-50" disabled>Önceki</button>
            <button class="px-3 py-1.5 rounded-md bg-primary-container text-on-primary font-semibold">1</button>
            <button class="px-3 py-1.5 rounded-md border border-outline-variant hover:bg-surface-container-low transition-colors">Sonraki</button>
        </div>
    </div>

</div>

