@using Rentaly.DtoLayer.CustomerDtos
@model UpdateCustomerDto
@{
    ViewData["Title"] = "Müşteri Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", (
        "Müşteri Bilgilerini Güncelle", 
        "Sistemde kayıtlı müşteri kimlik, iletişim ve ehliyet bilgilerini düzenleyebilirsiniz.", 
        "Müşteriler", 
        "", 
        "Listeye Dön", 
        true, 
        "/Admin/Customer/CustomerList"
    ))
}

<!-- Müşteri Başlık Şeridi -->
<div class="w-full bg-surface-container-low rounded-xl p-space-md mb-space-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
    <div class="flex items-center gap-space-md">
        <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[24px]">person_check</span>
        </div>
        <div>
            <div class="flex items-center gap-space-xs">
                <span class="font-headline-md text-headline-md text-on-surface">@Model.Name @Model.Surname</span>
                <span class="font-body-sm text-body-sm text-secondary">(Müşteri Kaydı)</span>
            </div>
            <div class="flex flex-wrap items-center gap-x-space-md gap-y-1 font-body-sm text-body-sm text-secondary mt-0.5">
                <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px] text-tertiary">badge</span> Müşteri ID: #CST-@Model.CustomerId.ToString("D4")
                </span>
                <span class="text-outline-variant">•</span>
                <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px] text-primary">fingerprint</span> TC: @Model.IdentityNumber
                </span>
                <span class="text-outline-variant">•</span>
                <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px] text-on-surface-variant">call</span> @Model.Phone
                </span>
            </div>
        </div>
    </div>
</div>

<form asp-area="Admin" asp-controller="Customer" asp-action="UpdateCustomer" method="post" class="flex flex-col w-full space-y-space-lg" id="editCustomerForm">
    @Html.AntiForgeryToken()
    
    <!-- Primary Key / Hidden Field -->
    <input type="hidden" asp-for="CustomerId" />

    <!-- CARD 1: Kimlik & Temel Müşteri Bilgileri -->
    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-lg">
        <div class="flex items-center justify-between pb-space-md mb-space-lg border-b border-outline-variant">
            <div class="flex items-center gap-space-sm">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">badge</span>
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">Kimlik &amp; Temel Müşteri Bilgileri</h2>
                    <p class="font-body-sm text-body-sm text-secondary">Nüfus ve vatandaşlık bilgilerine uygun kimlik kayıtları.</p>
                </div>
            </div>
            <span class="font-table-header text-table-header uppercase text-secondary bg-surface-container-low px-space-sm py-1 rounded">
                Zorunlu Alanlar
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
            <!-- Müşteri ID (Read-only) -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-secondary uppercase">Müşteri ID / Referans</label>
                <div class="relative">
                    <input class="w-full bg-surface-container-low rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface font-mono cursor-not-allowed focus:outline-none" 
                           value="#CST-@Model.CustomerId.ToString("D4")" readonly type="text" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-outline-variant text-[18px]">lock</span>
                </div>
            </div>

            <!-- T.C. Kimlik No -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="IdentityNumber">
                    T.C. Kimlik No <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="IdentityNumber" maxlength="11" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface font-mono shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="text" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-tertiary text-[18px]">fingerprint</span>
                </div>
                <span asp-validation-for="IdentityNumber" class="text-error text-[11px]"></span>
            </div>

            <!-- Ad -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="Name">
                    Müşteri Adı <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="Name" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="text" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-secondary text-[18px]">person</span>
                </div>
                <span asp-validation-for="Name" class="text-error text-[11px]"></span>
            </div>

            <!-- Soyad -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="Surname">
                    Müşteri Soyadı <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="Surname" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="text" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-secondary text-[18px]">person</span>
                </div>
                <span asp-validation-for="Surname" class="text-error text-[11px]"></span>
            </div>
        </div>
    </div>

    <!-- CARD 2: İletişim Bilgileri -->
    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-lg">
        <div class="flex items-center justify-between pb-space-md mb-space-lg border-b border-outline-variant">
            <div class="flex items-center gap-space-sm">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">contact_mail</span>
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">İletişim Bilgileri</h2>
                    <p class="font-body-sm text-body-sm text-secondary">E-posta adresi ve telefon numarası kayıtları.</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <!-- E-posta -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="Email">
                    E-Posta Adresi <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="Email" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="email" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-secondary text-[18px]">alternate_email</span>
                </div>
                <span asp-validation-for="Email" class="text-error text-[11px]"></span>
            </div>

            <!-- Telefon Numarası -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="Phone">
                    Cep Telefonu <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="Phone" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface font-mono shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="tel" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-secondary text-[18px]">call</span>
                </div>
                <span asp-validation-for="Phone" class="text-error text-[11px]"></span>
            </div>
        </div>
    </div>

    <!-- CARD 3: Sürücü Belgesi & Ehliyet Detayları -->
    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-lg">
        <div class="flex items-center justify-between pb-space-md mb-space-lg border-b border-outline-variant">
            <div class="flex items-center gap-space-sm">
                <div class="w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">badge</span>
                </div>
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-surface">Sürücü Belgesi &amp; Ehliyet Detayları</h2>
                    <p class="font-body-sm text-body-sm text-secondary">Kiralama sözleşmesi için geçerli ehliyet ve belge numarası bilgileri.</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <!-- Ehliyet Seri / Belge No -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="DrivingLicenseNumber">
                    Sürücü Belge No <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="DrivingLicenseNumber" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface font-mono shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="text" />
                    <span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-secondary text-[18px]">credit_card</span>
                </div>
                <span asp-validation-for="DrivingLicenseNumber" class="text-error text-[11px]"></span>
            </div>

            <!-- Ehliyet Veriliş Tarihi -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-table-header text-table-header text-on-surface font-semibold uppercase" asp-for="DrivingLicenseDate">
                    Ehliyet Veriliş Tarihi <span class="text-error">*</span>
                </label>
                <div class="relative">
                    <input asp-for="DrivingLicenseDate" class="w-full bg-surface-container-lowest rounded-lg px-space-md py-space-sm font-body-md text-body-md text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors border border-outline-variant" required type="date" asp-format="{0:yyyy-MM-dd}" />
                </div>
                <span asp-validation-for="DrivingLicenseDate" class="text-error text-[11px]"></span>
            </div>
        </div>
    </div>

    <!-- BOTTON ACTION BAR -->
    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-md flex flex-col sm:flex-row items-center justify-between gap-space-md">
        <div class="flex items-center gap-space-xs text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-tertiary text-[20px]">check_circle</span>
            <span>Müşteri güncellemeleri anında veritabanına ve ilgili sözleşmelere yansıtılır.</span>
        </div>
        <div class="flex items-center gap-space-sm w-full sm:w-auto justify-end">
            <a href="/Admin/Customer/CustomerList" class="px-space-lg py-space-sm rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-nav-item text-label-nav-item transition-colors text-center">
                Vazgeç
            </a>
            <button type="submit" class="flex items-center justify-center gap-space-xs px-space-xl py-space-sm rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-nav-item text-label-nav-item shadow-sm transition-all">
                <span class="material-symbols-outlined text-[20px]">save</span>
                <span>Değişiklikleri Kaydet</span>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}