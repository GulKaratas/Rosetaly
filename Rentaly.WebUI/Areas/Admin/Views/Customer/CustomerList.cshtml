@using Rentaly.DtoLayer.CustomerDtos
@model List<ResultCustomerDto>
@{
    ViewData["Title"] = "CustomerList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeaderPartial", ("Müşteriler", "Sisteme kayıtlı müşterilerin listesi ve iletişim bilgileri", "Müşteriler", "/Admin/Customer/CreateCustomer/", "Yeni Müşteri Ekle", false, ""))
}
<!-- Ana Yönetim Kartı & Tablo -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col">
    
    <!-- Filtreleme ve Arama Çubuğu -->
    <div class="p-4 sm:p-5 border-b border-outline-variant bg-surface-container-lowest flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1 max-w-md relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input type="text" id="customerSearchInput" placeholder="Ad, soyad, TC kimlik, e-posta veya telefon ara..."
                   class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:bg-surface-container-lowest transition-all" />
        </div>
        
        <div class="flex items-center gap-3 flex-wrap">
            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="">Tüm Ehliyet Yaşları</option>
                <option value="experienced">2+ Yıl Deneyimli</option>
                <option value="senior">5+ Yıl Deneyimli</option>
                <option value="new">Yeni Sürücü (<2 Yıl)</option>
            </select>

            <select class="px-3.5 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary">
                <option value="name-asc">Sırala: Ad Soyad (A - Z)</option>
                <option value="name-desc">Sırala: Ad Soyad (Z - A)</option>
                <option value="id-desc">Son Kayıt Olanlar</option>
                <option value="license-desc">Ehliyet Tarihine Göre</option>
            </select>

            <button type="button" class="p-2 rounded-lg border border-outline-variant text-secondary hover:text-on-surface hover:bg-surface-container-low transition-colors" title="Filtreleri Sıfırla">
                <span class="material-symbols-outlined text-[20px]">restart_alt</span>
            </button>
        </div>
    </div>

    <!-- Veri Tablosu -->
    <div class="overflow-x-auto w-full">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant text-secondary text-[12px] uppercase tracking-wider font-semibold">
                    <th class="py-3.5 px-4 w-12 text-center">
                        <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                    </th>
                    <th class="py-3.5 px-4 w-20">ID</th>
                    <th class="py-3.5 px-4">MÜŞTERİ AD SOYAD</th>
                    <th class="py-3.5 px-4">TC KİMLİK NO</th>
                    <th class="py-3.5 px-4">İLETİŞİM</th>
                    <th class="py-3.5 px-4">EHLİYET BİLGİSİ</th>
                    <th class="py-3.5 px-4">DURUM</th>
                    <th class="py-3.5 px-4 text-right">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant text-sm">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var licenseYears = DateTime.Now.Year - item.DrivingLicenseDate.Year;
                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-3.5 px-4 text-center">
                                <input type="checkbox" class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
                            </td>
                            <td class="py-3.5 px-4 font-mono text-xs text-secondary font-semibold">
                                #@item.CustomerId.ToString("D2")
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-primary/10 text-primary border border-outline-variant flex items-center justify-center font-bold text-xs shrink-0">
                                        @((item.Name?.Length > 0 ? item.Name.Substring(0, 1) : "") + (item.Surname?.Length > 0 ? item.Surname.Substring(0, 1) : ""))
                                    </div>
                                    <div>
                                        <span class="font-bold text-on-surface block text-sm">@item.Name @item.Surname</span>
                                        <span class="text-[11px] text-outline font-mono">CST-@item.CustomerId.ToString("D4")</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="font-mono text-xs text-on-surface bg-surface-container px-2 py-1 rounded border border-outline-variant">
                                    @(item.IdentityNumber?.Length >= 11 ? item.IdentityNumber.Substring(0, 3) + "*****" + item.IdentityNumber.Substring(8, 3) : item.IdentityNumber)
                                </span>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex flex-col gap-0.5">
                                    <div class="flex items-center gap-1.5 text-xs text-on-surface">
                                        <span class="material-symbols-outlined text-[14px] text-secondary">mail</span>
                                        <span>@item.Email</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-[11px] text-secondary font-mono">
                                        <span class="material-symbols-outlined text-[14px] text-secondary">phone</span>
                                        <span>@item.Phone</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex flex-col gap-0.5">
                                    <div class="flex items-center gap-1.5 text-xs text-on-surface font-mono font-medium">
                                        <span class="material-symbols-outlined text-[14px] text-primary">badge</span>
                                        <span>No: @item.DrivingLicenseNumber</span>
                                    </div>
                                    <span class="text-[11px] text-outline">
                                        Veriliş: @item.DrivingLicenseDate.ToString("dd.MM.yyyy") (@licenseYears Yıllık)
                                    </span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    Doğrulandı
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="inline-flex items-center gap-1">
   
    <a href="/Admin/Customer/UpdateCustomer/@item.CustomerId" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Düzenle">
        <span class="material-symbols-outlined text-[18px]">edit</span>
    </a>

    <form asp-area="Admin" asp-controller="Customer" asp-action="DeleteCustomer" asp-route-id="@item.CustomerId" method="post" class="inline" onsubmit="return confirm('@item.Name @item.Surname müşterisini silmek istediğinize emin misiniz?');">
        <button type="submit" class="p-1.5 rounded-lg text-secondary hover:text-error hover:bg-error-container/30 transition-colors" title="Sil">
            <span class="material-symbols-outlined text-[18px]">delete</span>
        </button>
    </form>
</div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="py-12 text-center text-secondary">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[40px] text-outline">group</span>
                                <p class="font-medium text-sm text-on-surface">Kayıtlı müşteri bulunamadı.</p>
                                <p class="text-xs text-outline">Henüz bir müşteri tanımlanmamış. İlk müşterinizi ekleyebilirsiniz.</p>
                                <a href="/Customers/CreateCustomer" class="mt-2 inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-primary-container text-on-primary text-xs font-semibold">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Yeni Müşteri Ekle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Sayfalama ve Alt Özet -->
    <div class="p-4 sm:p-5 border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary">
        <div>
            Toplam <span class="font-bold text-on-surface">@(Model?.Count ?? 0)</span> müşteriden <span class="font-semibold text-on-surface">1 - @(Model?.Count ?? 0)</span> arası gösteriliyor
        </div>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 rounded-md border border-outline-variant text-outline hover:bg-surface-container-low transition-colors disabled:opacity-50" disabled>Önceki</button>
            <button class="px-3 py-1.5 rounded-md bg-primary-container text-on-primary font-semibold">1</button>
            <button class="px-3 py-1.5 rounded-md border border-outline-variant hover:bg-surface-container-low transition-colors">Sonraki</button>
        </div>
    </div>

</div>