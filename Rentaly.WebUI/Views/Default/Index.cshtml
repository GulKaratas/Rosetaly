@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}
<div class="no-bottom no-top" id="content">
    <div id="top"></div>
    <!-- 1. HERO SLIDER CAROUSEL -->
    <section class="hero-section carousel slide carousel-fade" data-bs-interval="5000" data-bs-ride="carousel" id="de-carousel">
        <div class="carousel-indicators">
            <button aria-label="Slayt 1" class="active" data-bs-slide-to="0" data-bs-target="#de-carousel" type="button"></button>
            <button aria-label="Slayt 2" data-bs-slide-to="1" data-bs-target="#de-carousel" type="button"></button>
            <button aria-label="Slayt 3" data-bs-slide-to="2" data-bs-target="#de-carousel" type="button"></button>
        </div>
        <div class="carousel-inner">
            <!-- Slide 1 -->
            <div class="carousel-item active">
                <div class="hero-slide" style="background-image: url('/images/4.jpeg');">
                    <div class="hero-overlay">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-8">
                                    <div class="hero-tag"><i class="fa fa-shield-alt"></i> Güvenli &amp; Anlık Rezervasyon</div>
                                    <h1 class="hero-title">Premium Araçlar,<br /><span class="text-primary-custom">Kusursuz Konfor.</span></h1>
                                    <p class="hero-desc">Dünyayı benzersiz konfor ve şıklıkla keşfedin. Seçilen araç tarih boyunca size rezerve edilir ve kilitlenir.</p>
                                    <div class="d-flex flex-wrap gap-3">
                                        <a class="btn btn-custom-primary" href="#section-filter"><i class="fa fa-calendar-check"></i> Tarihe Göre Araç Bul</a>
                                        <a class="btn btn-outline-light px-4 py-3 rounded-3 fw-bold" href="#section-cars">Araçları İncele</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Slide 2 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image: url('/images/1.jpeg');">
                    <div class="hero-overlay">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-8">
                                    <div class="hero-tag"><i class="fa fa-star"></i> VIP Filo &amp; 7/24 Destek</div>
                                    <h1 class="hero-title">Birinci Sınıf Deneyim,<br /><span class="text-primary-custom">Şeffaf Fiyat Garantisi.</span></h1>
                                    <p class="hero-desc">Sürpriz masraf yok, gizli ücret yok. AI destekli kimlik okutma ile form doldurmadan saniyeler içinde yola çıkın.</p>
                                    <div class="d-flex flex-wrap gap-3">
                                        <a class="btn btn-custom-primary" href="#section-cars"><i class="fa fa-car"></i> Araçları Keşfet</a>
                                        <button class="btn btn-ocr" data-bs-target="#ocrModal" data-bs-toggle="modal"><i class="fa fa-camera"></i> Hızlı Kimlik Tara</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Slide 3 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image: url('/images/2.jpeg');">
                    <div class="hero-overlay">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-8">
                                    <div class="hero-tag"><i class="fa fa-check-circle"></i> Tam Kapsamlı Kasko</div>
                                    <h1 class="hero-title">Güvenli Yolculuk,<br /><span class="text-primary-custom">Ödüllü Hizmet Kalitesi.</span></h1>
                                    <p class="hero-desc">Tüm bakımları eksiksiz yapılmış lüks ve ekonomik SUV, Sedan ve Spor modellerimizle yola hazırsınız.</p>
                                    <div class="d-flex flex-wrap gap-3">
                                        <a class="btn btn-custom-primary" href="#section-filter">Rezervasyona Başla</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" data-bs-slide="prev" data-bs-target="#de-carousel" type="button">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" data-bs-slide="next" data-bs-target="#de-carousel" type="button">
            <span class="carousel-control-next-icon"></span>
        </button>
    </section>
    <!-- DİNAMİK ARAMA FİLTRESİ & TARİH KİLİTLEME PANELİ -->
    @await Component.InvokeAsync("_DefaultSearchComponentPartial")
    
    <!-- 2. MARKALAR & MODELLER (Hızlı Filtreleme Bantı) -->
    @await Component.InvokeAsync("_DefaultBrandComponentPartial")
    
    <!-- 3. PROCESS / İŞLEYİŞ -->
    <section class="section-padding bg-dark bg-opacity-50" id="section-process">
        <div class="container">
            <div class="text-center section-title-wrap">
                <span class="section-subtitle">Nasıl Çalışır?</span>
                <h2 class="section-title">4 Kolay Adımda Rezervasyon İşleyişi</h2>
                <p class="text-muted mx-auto" style="max-width: 650px;">
                    Aracınızı dakikalar içinde kiralayın, anlık tarih kilit sistemi ve OCR kimlik doğrulamasıyla beklemeden teslim alın.
                </p>
            </div>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="process-card">
                        <span class="process-step-num">01</span>
                        <div class="process-icon"><i class="fa fa-calendar-alt"></i></div>
                        <h4>Tarih &amp; Lokasyon Seç</h4>
                        <p class="text-muted small">İhtiyacınız olan alış-iade tarihlerini ve havaalanı veya şehir ofisimizi belirleyin.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="process-card">
                        <span class="process-step-num">02</span>
                        <div class="process-icon"><i class="fa fa-car"></i></div>
                        <h4>Müsait Aracı Kilitle</h4>
                        <p class="text-muted small">Seçtiğiniz tarihte müsait 10 seçkin araç arasından dilediğinizi anında rezerve edip kilitleyin.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="process-card">
                        <span class="process-step-num">03</span>
                        <div class="process-icon"><i class="fa fa-camera-retro"></i></div>
                        <h4>Hızlı Kimlik OCR</h4>
                        <p class="text-muted small">Kameradan ya da dosyadan kimliğinizi yükleyin; sözleşme ve ehliyet formları otomatik dolsun.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="process-card">
                        <span class="process-step-num">04</span>
                        <div class="process-icon"><i class="fa fa-key"></i></div>
                        <h4>Anahtarı Teslim Al</h4>
                        <p class="text-muted small">Ücretsiz karşılama ve ekspres teslimatla maceranıza vakit kaybetmeden start verin.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- 4. ARAÇLAR (İLK 10 ARAÇ LİSTESİ - DİNAMİK / TARİH KİLİTLEME ENTEGRELİ) -->
    @await Component.InvokeAsync("_DefaultTopCarsComponentPartial")
   
    <!-- 5. OUR FUTURE (Geleceğimiz & Vizyonumuz) -->
    @await Component.InvokeAsync("_DefaultOurFeatureComponentPartial")

    <!-- 6. İSTATİSTİKLER & ABOUT (HAKKIMIZDA) -->
    @await Component.InvokeAsync("_DefaultAboutComponentPartial")
    
    <!-- 7. ÖDÜLLER (AWARDS) -->
    @await Component.InvokeAsync("_DefaultAwardsComponentPartial")
  
    <!-- 8. TESTIMONIAL (MÜŞTERİ YORUMLARI) -->
    @await Component.InvokeAsync("_DefaultTestimonialComponentPartial")
    
    <!-- 9. SIKÇA SORULAN SORULAR (FAQ) -->
    @await Component.InvokeAsync("_DefaultFAQComponentPartial")
 
</div>
<div aria-hidden="true" aria-labelledby="ocrModalLabel" class="modal fade" id="ocrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-custom">
            <div class="modal-header border-secondary border-opacity-25 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-camera-retro text-primary-custom fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold" id="ocrModalLabel">Yapay Zeka ile Kimlik &amp; Ehliyet Tarama</h5>
                        <small class="text-muted">Kamera veya dosya yüklemesi ile rezervasyon formunu anında doldurun.</small>
                    </div>
                </div>
                <button aria-label="Close" class="btn-close btn-close-white" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Yükleme / Kamera Alanı -->
                    <div class="col-md-6">
                        <div class="ocr-dropzone mb-3" onclick="simulateOcrScan()">
                            <i class="fa fa-cloud-arrow-up text-primary-custom fs-1 mb-2"></i>
                            <h6 class="fw-bold">Kimlik / Ehliyet Fotoğrafı Yükle</h6>
                            <p class="text-muted small mb-3">Masaüstünden sürükleyin veya dosya seçin</p>
                            <span class="btn btn-outline-light btn-sm">Dosya Seç</span>
                        </div>
                        <div class="text-center mb-2">
                            <span class="text-muted small">— VEYA —</span>
                        </div>
                        <button class="btn btn-dark border-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2" onclick="simulateOcrScan()">
                            <i class="fa fa-camera text-primary-custom"></i>
                            <span>Kamerayı Aç ve Kimliği Okut</span>
                        </button>
                        <div class="mt-3 p-2 rounded small text-center text-primary-custom" id="ocrStatusMsg" style="display:none; background: rgba(30,203,21,0.1);">
                            <i class="fa fa-spinner fa-spin me-1"></i> Kimlik bilgileri yapay zeka ile taranıyor...
                        </div>
                    </div>
                    <!-- Otomatik Doldurulan Rezervasyon Formu -->
                    <div class="col-md-6">
                        <h6 class="fw-bold text-white mb-3"><i class="fa fa-clipboard-check text-primary-custom me-2"></i>Otomatik Çıkarılan Bilgiler</h6>
                        <form id="bookingForm" onsubmit="event.preventDefault(); alert('Rezervasyonunuz oluşturuldu ve araç kilitlendi!');">
                            <div class="mb-2">
                                <label class="form-label text-muted small mb-1">Ad Soyad</label>
                                <input class="form-control bg-dark border-secondary text-white" id="ocrFullName" placeholder="Örn: Selin Aksoy" type="text" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label text-muted small mb-1">T.C. / Pasaport No</label>
                                    <input class="form-control bg-dark border-secondary text-white" id="ocrIdNumber" placeholder="11 haneli T.C." type="text" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-muted small mb-1">Doğum Tarihi</label>
                                    <input class="form-control bg-dark border-secondary text-white" id="ocrBirthDate" type="date" />
                                </div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label text-muted small mb-1">Ehliyet Sınıfı</label>
                                    <input class="form-control bg-dark border-secondary text-white" id="ocrLicenseClass" placeholder="B Sınıfı (Min 2 Yıl)" type="text" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-muted small mb-1">Telefon</label>
                                    <input class="form-control bg-dark border-secondary text-white" id="ocrPhone" placeholder="0532 000 00 00" type="tel" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Seçilen Kilitli Araç</label>
                                <input class="form-control bg-dark border-secondary text-primary-custom fw-bold" id="ocrSelectedCar" readonly="" type="text" value="Jeep Renegade Limited" />
                            </div>
                            <button class="btn btn-custom-primary w-100" type="submit">
                                <i class="fa fa-check"></i> Bilgileri Onayla &amp; Kiralama Tamamla
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 10. CALL TO ACTION / HIZLI DESTEK -->
<section class="py-5" id="section-call-to-action" style="background: linear-gradient(135deg, #11151c 0%, #17202b 100%); border-top: 1px solid var(--border-color);">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="text-primary-custom fw-bold text-uppercase small">7/24 Müşteri İletişim Hattı</span>
                <h2 class="text-white mt-1 mb-2">Herhangi Bir Sorunuz mu Var?</h2>
                <p class="text-muted mb-0">Uzman kiralama danışmanlarımız rota planlaması ve araç tercihinde bir telefon uzağınızda.</p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <div class="d-inline-flex align-items-center gap-3 p-3 rounded-4" style="background: var(--dark-card); border: 1px solid var(--border-color);">
                    <div class="rounded-circle bg-primary-custom text-dark d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; font-size: 1.4rem;">
                        <i class="fa fa-phone"></i>
                    </div>
                    <div class="text-start me-3">
                        <small class="text-muted d-block">Hemen Arayın</small>
                        <span class="fs-4 fw-bold text-white">0850 333 8000</span>
                    </div>
                    <a class="btn btn-custom-primary" href="#section-filter">Rezervasyon Yap</a>
                </div>
            </div>
        </div>
    </div>
</section>