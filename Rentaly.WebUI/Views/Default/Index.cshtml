                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success bg-opacity-25 text-success p-2">8 Müsait</span>
                    <span class="badge bg-danger bg-opacity-25 text-danger p-2">2 Kilitli (Dolu)</span>
                </div>
            </div>
            <div class="row g-4" id="carsListContainer">
                <!-- Araç 1: Jeep Renegade -->
                <div class="col-lg-4 col-md-6 car-item-box" data-available="true" data-category="suv">
                    <div class="car-card">
                        <div class="car-thumb">
                            <span class="car-badge">SUV • 4x4</span>
                            <span class="car-status-available"><i class="fa fa-check"></i> Müsait</span>
                            <img alt="Jeep Renegade" src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg" />
                        </div>
                        <div class="car-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h4 class="mb-1">Jeep Renegade Limited</h4>
                                    <small class="text-muted">Model Yılı: 2024 • Benzin</small>
                                </div>
                                <span class="badge bg-dark text-warning"><i class="fa fa-star"></i> 4.9</span>
                            </div>
                            <div class="car-specs-grid">
                                <div class="car-spec-item"><i class="fa fa-user-group"></i> 5 Kişi</div>
                                <div class="car-spec-item"><i class="fa fa-suitcase"></i> 3 Bavul</div>
                                <div class="car-spec-item"><i class="fa fa-cogs"></i> Otomatik</div>
                                <div class="car-spec-item"><i class="fa fa-gas-pump"></i> 6.8L/100</div>
                            </div>
                            <div class="car-price-row">
                                <div class="price-val">₺2.450 <span>/ Günlük</span></div>
                                <button class="btn btn-custom-primary btn-sm px-3" onclick="lockAndBookCar('Jeep Renegade Limited', '₺2.450')">
                                    <i class="fa fa-lock"></i> Rezerve Et
                                </button>
                            </div>
                        </div>
