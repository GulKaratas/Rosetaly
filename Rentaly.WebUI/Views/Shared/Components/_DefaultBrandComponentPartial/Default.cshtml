@model List<Rentaly.EntityLayer.Entities.Brand>

<section class="section-padding pb-4">

    <div class="container">

        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">

            <div>
                <span class="section-subtitle">
                    Dinamik Marka &amp; Model Havuzu
                </span>

                <h3 class="mb-0">
                    Araç Markaları
                </h3>
            </div>

            <span class="badge bg-secondary bg-opacity-25 px-3 py-2 text-white">
                Toplam @Model.Count Marka Aktif
            </span>

        </div>


        <!-- Yatay kayan alan -->
        <div class="brand-slider">

            <div class="brand-track">

                @foreach (var item in Model)
                {
                    <div class="brand-item">

                        <div class="brand-chip">

                            <i class="fa-solid fa-car text-primary-custom"></i>

                            <div>
                                <div class="fw-bold">
                                    @item.BrandName
                                </div>
                            </div>

                        </div>

                    </div>
                }


                <!-- Listeyi tekrar ediyoruz -->
                @foreach (var item in Model)
                {
                    <div class="brand-item">

                        <div class="brand-chip">

                            <i class="fa-solid fa-car text-primary-custom"></i>

                            <div>
                                <div class="fw-bold">
                                    @item.BrandName
                                </div>
                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</section>