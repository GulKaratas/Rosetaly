<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rentaly - Lüks &amp; Konforlu Araç Kiralama</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;family=Outfit:wght@400;600;700;800&amp;display=swap" rel="stylesheet" />
    <style>
            :root {
                --primary-color: #1ecb15;
                --primary-dark: #169b10;
                --primary-light: rgba(30, 203, 21, 0.12);
                --dark-bg: #11141a;
                --dark-card: #181d24;
                --dark-card-hover: #1f2530;
                --text-muted: #8e9aab;
                --border-color: rgba(255, 255, 255, 0.08);
                --accent-gold: #f59e0b;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #0d0f13;
                color: #ffffff;
                overflow-x: hidden;
            }

            h1, h2, h3, h4, h5, .font-heading {
                font-family: 'Outfit', sans-serif;
                font-weight: 700;
                letter-spacing: -0.02em;
            }

            .text-primary-custom { color: var(--primary-color) !important; }
            .bg-primary-custom { background-color: var(--primary-color) !important; }

            /* Navigation Header */
            .header-nav {
                background: rgba(13, 15, 19, 0.85);
                backdrop-filter: blur(16px);
                border-bottom: 1px solid var(--border-color);
                position: fixed;
                top: 0;
                width: 100%;
                z-index: 1050;
                transition: all 0.3s ease;
            }

            .navbar-brand .logo-badge {
                width: 42px;
                height: 42px;
                background: linear-gradient(135deg, var(--primary-color), #0fa307);
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: #000;
                font-weight: 900;
                font-size: 1.4rem;
            }

            .nav-link {
                color: #d1d5db !important;
                font-size: 0.95rem;
                font-weight: 500;
                padding: 8px 16px !important;
                transition: color 0.2s;
            }
            .nav-link:hover, .nav-link.active {
                color: var(--primary-color) !important;
            }

            /* Hero Carousel */
            .hero-section {
                position: relative;
                margin-top: 76px;
                min-height: 85vh;
            }

            .hero-slide {
                height: 85vh;
                background-size: cover;
                background-position: center;
                position: relative;
            }

            .hero-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg, rgba(13,15,19,0.3) 0%, rgba(13,15,19,0.85) 75%, #0d0f13 100%);
                display: flex;
                align-items: center;
            }

            .hero-tag {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 6px 16px;
                background: rgba(30, 203, 21, 0.15);
                border: 1px solid rgba(30, 203, 21, 0.3);
                border-radius: 50px;
                color: var(--primary-color);
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 1.25rem;
            }

            .hero-title {
                font-size: 3.8rem;
                line-height: 1.15;
                font-weight: 800;
                margin-bottom: 1.2rem;
            }

            .hero-desc {
                font-size: 1.25rem;
                color: #d0d7e2;
                max-width: 620px;
                margin-bottom: 2rem;
                font-weight: 300;
            }

            /* Search Filter Box (Floating Bar) */
            .search-floating-card {
                background: rgba(24, 29, 36, 0.95);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 20px;
                padding: 28px;
                box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7);
                margin-top: -80px;
                position: relative;
                z-index: 20;
            }

            .filter-field {
                background: #11141a;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                padding: 10px 14px;
                transition: all 0.2s;
            }
            .filter-field:focus-within {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(30, 203, 21, 0.15);
            }
            .filter-field label {
                font-size: 0.72rem;
                text-transform: uppercase;
                color: var(--text-muted);
                font-weight: 700;
                letter-spacing: 0.5px;
                display: block;
                margin-bottom: 2px;
            }
            .filter-field input, .filter-field select {
                background: transparent;
                border: none;
                color: #ffffff;
                font-size: 0.95rem;
                font-weight: 600;
                width: 100%;
                outline: none;
            }
            .filter-field select option {
                background-color: #181d24;
                color: #fff;
            }

            /* Buttons */
            .btn-custom-primary {
                background: var(--primary-color);
                color: #0b0f14;
                font-weight: 700;
                padding: 14px 28px;
                border-radius: 12px;
                border: none;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }
            .btn-custom-primary:hover {
                background: #25e01b;
                color: #000;
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(30, 203, 21, 0.35);
            }

            .btn-ocr {
                background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
                border: 1px dashed rgba(30, 203, 21, 0.5);
                color: #e5e7eb;
                border-radius: 12px;
                padding: 12px 20px;
                font-size: 0.88rem;
                transition: all 0.2s;
            }
            .btn-ocr:hover {
                border-color: var(--primary-color);
                background: rgba(30, 203, 21, 0.08);
                color: var(--primary-color);
            }

            /* Section Styling */
            .section-padding {
                padding: 90px 0;
                position: relative;
            }
            .section-title-wrap {
                margin-bottom: 48px;
            }
            .section-subtitle {
                color: var(--primary-color);
                font-size: 0.85rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 2px;
                margin-bottom: 8px;
                display: block;
            }
            .section-title {
                font-size: 2.5rem;
                color: #fff;
                margin-bottom: 12px;
            }

            /* Process Steps */
            .process-card {
                background: var(--dark-card);
                border: 1px solid var(--border-color);
                border-radius: 18px;
                padding: 32px 24px;
                position: relative;
                transition: all 0.3s;
                height: 100%;
            }
            .process-card:hover {
                transform: translateY(-6px);
                border-color: rgba(30, 203, 21, 0.4);
                box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            }
            .process-step-num {
                position: absolute;
                top: 20px;
                right: 20px;
                font-size: 2.8rem;
                font-weight: 900;
                color: rgba(255, 255, 255, 0.04);
                font-family: 'Outfit', sans-serif;
            }
            .process-icon {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                background: var(--primary-light);
                color: var(--primary-color);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.6rem;
                margin-bottom: 22px;
            }

            /* Cars Grid (10 Cars) */
            .car-card {
                background: var(--dark-card);
                border: 1px solid var(--border-color);
                border-radius: 18px;
                overflow: hidden;
                transition: all 0.3s;
                position: relative;
            }
            .car-card:hover {
                transform: translateY(-6px);
                border-color: rgba(30, 203, 21, 0.35);
                box-shadow: 0 20px 35px rgba(0,0,0,0.45);
            }
            .car-thumb {
                position: relative;
                height: 200px;
                background: #0f1217;
                overflow: hidden;
            }
            .car-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }
            .car-card:hover .car-thumb img {
                transform: scale(1.05);
            }
            .car-badge {
                position: absolute;
                top: 14px;
                left: 14px;
                background: rgba(13, 15, 19, 0.85);
                backdrop-filter: blur(8px);
                border: 1px solid rgba(255,255,255,0.1);
                color: #fff;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 600;
            }
            .car-status-locked {
                position: absolute;
                top: 14px;
                right: 14px;
                background: #ef4444;
                color: #fff;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 0.72rem;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 5px;
            }
            .car-status-available {
                position: absolute;
                top: 14px;
                right: 14px;
                background: var(--primary-color);
                color: #000;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 0.72rem;
                font-weight: 800;
            }
            .car-body {
                padding: 22px;
            }
            .car-specs-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 8px;
                padding: 12px 0;
                margin: 14px 0;
                border-top: 1px solid var(--border-color);
                border-bottom: 1px solid var(--border-color);
            }
            .car-spec-item {
                text-align: center;
                font-size: 0.78rem;
                color: var(--text-muted);
            }
            .car-spec-item i {
                color: var(--primary-color);
                display: block;
                margin-bottom: 3px;
                font-size: 0.9rem;
            }
            .car-price-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .price-val {
                font-size: 1.5rem;
                font-weight: 800;
                color: #ffffff;
                font-family: 'Outfit', sans-serif;
            }
            .price-val span {
                font-size: 0.8rem;
                color: var(--text-muted);
                font-weight: 400;
            }

            /* Brand & Model Pills */
            .brand-chip {
                background: var(--dark-card);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                padding: 16px 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                transition: all 0.25s;
                cursor: pointer;
                text-decoration: none;
                color: #fff;
            }
            .brand-chip:hover, .brand-chip.active {
                border-color: var(--primary-color);
                background: rgba(30, 203, 21, 0.08);
                color: var(--primary-color);
                transform: translateY(-3px);
            }
            .brand-chip i {
                font-size: 1.5rem;
            }

            /* Stats Counter Section */
            .stat-box {
                background: linear-gradient(145deg, rgba(24, 29, 36, 0.9), rgba(17, 20, 26, 0.95));
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 35px 20px;
                text-align: center;
            }
            .stat-number {
                font-size: 3rem;
                font-weight: 800;
                font-family: 'Outfit', sans-serif;
                color: var(--primary-color);
                line-height: 1;
                margin-bottom: 8px;
            }
            .stat-label {
                color: #d1d5db;
                font-size: 0.95rem;
                font-weight: 500;
            }

            /* Future / Innovation Vision */
            .future-feature-box {
                background: var(--dark-card);
                border-left: 4px solid var(--primary-color);
                border-radius: 0 14px 14px 0;
                padding: 22px;
                margin-bottom: 16px;
                transition: transform 0.2s;
            }
            .future-feature-box:hover {
                transform: translateX(6px);
                background: var(--dark-card-hover);
            }

            /* Awards Badges */
            .award-card {
                background: var(--dark-card);
                border: 1px solid var(--border-color);
                border-radius: 18px;
                padding: 28px;
                text-align: center;
                transition: all 0.3s;
            }
            .award-card:hover {
                border-color: var(--accent-gold);
                transform: translateY(-5px);
            }
            .award-icon-wrap {
                width: 70px;
                height: 70px;
                margin: 0 auto 18px;
                border-radius: 50%;
                background: rgba(245, 158, 11, 0.12);
                color: var(--accent-gold);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
            }

            /* Testimonial Cards */
            .testimonial-card {
                background: var(--dark-card);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 32px;
                position: relative;
                height: 100%;
            }
            .testi-quote-icon {
                color: var(--primary-color);
                font-size: 1.8rem;
                opacity: 0.8;
                margin-bottom: 14px;
            }
            .avatar-img {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid var(--primary-color);
            }

            /* FAQ Accordion */
            .custom-accordion .accordion-item {
                background: var(--dark-card);
                border: 1px solid var(--border-color);
                border-radius: 14px !important;
                margin-bottom: 14px;
                overflow: hidden;
            }
            .custom-accordion .accordion-button {
                background: var(--dark-card);
                color: #fff;
                font-weight: 600;
                padding: 20px 24px;
                box-shadow: none;
            }
            .custom-accordion .accordion-button:not(.collapsed) {
                background: rgba(30, 203, 21, 0.08);
                color: var(--primary-color);
            }
            .custom-accordion .accordion-button::after {
                filter: invert(1);
            }
            .custom-accordion .accordion-body {
                color: #9ca3af;
                font-size: 0.95rem;
                line-height: 1.7;
                padding: 0 24px 22px;
            }

            /* OCR Camera / File Upload Modal */
            .modal-content-custom {
                background: #14181f;
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 22px;
                color: #fff;
            }
            .ocr-dropzone {
                border: 2px dashed rgba(30, 203, 21, 0.4);
                border-radius: 16px;
                padding: 35px 20px;
                text-align: center;
                background: rgba(30, 203, 21, 0.03);
                cursor: pointer;
                transition: all 0.2s;
            }
            .ocr-dropzone:hover {
                border-color: var(--primary-color);
                background: rgba(30, 203, 21, 0.08);
            }

            /* Live Lock Notification Banner */
            .lock-indicator {
                background: linear-gradient(90deg, rgba(239, 68, 68, 0.15), rgba(239, 68, 68, 0.05));
                border-left: 3px solid #ef4444;
                padding: 8px 14px;
                border-radius: 0 8px 8px 0;
                font-size: 0.82rem;
                color: #fca5a5;
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 10px;
            }

            /* Footer */
            .site-footer {
                background: #090b0e;
                border-top: 1px solid var(--border-color);
                padding: 70px 0 30px;
                color: var(--text-muted);
            }

            .brand-slider {
    width: 100%;
    overflow: hidden;
    position: relative;
}

.brand-track {
    display: flex;
    width: max-content;
    gap: 16px;

    animation: brandScroll 25s linear infinite;
}

.brand-item {
    flex: 0 0 auto;
    width: 180px;
}

.brand-chip {
    height: 75px;

    display: flex;
    align-items: center;
    gap: 14px;

    padding: 15px 20px;

    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;

    background: rgba(255, 255, 255, 0.03);

    white-space: nowrap;

    transition: all 0.3s ease;
}

.brand-chip i {
    font-size: 24px;
    flex-shrink: 0;
}

.brand-chip:hover {
    transform: translateY(-3px);
    border-color: var(--primary-color);
}


/* Sürekli yatay hareket */

@@keyframes brandScroll {

    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(calc(-50% - 8px));
    }

}


/* Mouse üzerine gelince dur */

.brand-slider:hover .brand-track {
    animation-play-state: paused;
}


/* Mobil */

@@media (max-width: 767px) {

    .brand-item {
        width: 160px;
    }

    .brand-chip {
        height: 65px;
        padding: 12px 15px;
    }

    .brand-chip i {
        font-size: 20px;
    }

}

/* Araç Slider Alanı */
.car-slider-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
}

/* Yatay kayan araçlar */
.car-slider-track {
    display: flex;
    gap: 24px;
    transition: transform 0.5s ease-in-out;
    will-change: transform;
}

/* Her slaytta bir araç */
.car-slide {
    flex: 0 0 calc((100% - 48px) / 3);
    min-width: 0;
    display: flex;
}

.car-slide .car-card {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.car-slide .car-thumb img {
    width: 100%;
    height: 220px;
    object-fit: contain;
}

.car-slide .car-bodyz {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.car-slide .car-price-row {
    margin-top: auto;
    padding-top: 20px;
}

/* Slider okları */
.car-slider-arrow {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: #1c1c1c;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
}

.car-slider-arrow:hover:not(:disabled) {
    background: #e8b44c;
    color: #111;
    border-color: #e8b44c;
}

.car-slider-arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
}

/* Tablet: 2 araç */
@@media (max-width: 991px) {
    .car-slide {
        flex-basis: calc((100% - 24px) / 2);
    }
}

/* Mobil: 1 araç */
@@media (max-width: 575px) {
    .car-slide {
        flex-basis: 100%;
    }

    .car-slider-track {
        gap: 16px;
    }

    .car-slide .car-thumb img {
        height: 200px;
    }
}



            /* =====================================================
               GENEL OKUNABİLİRLİK / KONTRAST DÜZELTMELERİ
               Koyu Rentaly tasarımında soluk kalan metinleri iyileştirir.
               ===================================================== */
            :root {
                --text-muted: #b8c2d0;
            }

            /* Bootstrap'in muted sınıfları koyu zeminde daha okunaklı olsun. */
            .text-muted,
            .text-body-secondary {
                color: #b8c2d0 !important;
            }

            /* Bootstrap text-white-50 varsayılan %50 opaklığı fazla soluk kalıyor. */
            .text-white-50 {
                color: #c4ccd7 !important;
                opacity: 1 !important;
            }

            /* Genel açıklama ve küçük metinler */
            p {
                color: inherit;
            }

            small,
            .small {
                color: #c4ccd7;
            }

            /* Kartlar üzerindeki metin kontrastı */
            .process-card,
            .car-card,
            .stat-box,
            .award-card,
            .testimonial-card,
            .future-feature-box,
            .brand-chip {
                color: #e5eaf1;
            }

            .process-card p,
            .car-card p,
            .award-card p,
            .testimonial-card p,
            .future-feature-box p,
            .future-feature-box small,
            .testimonial-card small,
            .award-card small {
                color: #c4ccd7;
                line-height: 1.7;
            }

            /* Araç teknik bilgileri ve günlük fiyat açıklaması */
            .car-spec-item,
            .price-val span {
                color: #b8c2d0 !important;
            }

            /* SSS açıklamaları */
            .custom-accordion .accordion-body {
                color: #c4ccd7 !important;
            }

            /* Alt bilgi bağlantıları */
            .site-footer,
            .site-footer p,
            .site-footer small {
                color: #b8c2d0;
            }

            .site-footer a {
                color: #dbe2eb;
            }

            .site-footer a:hover {
                color: var(--primary-color);
            }

            /* Form alanları ve placeholder metinleri */
            input::placeholder,
            textarea::placeholder {
                color: #aeb8c6;
                opacity: 1;
            }

            /* Metin rengi açık olan kutularda başlıklar net kalsın. */
            .process-card h3,
            .process-card h4,
            .car-card h3,
            .car-card h4,
            .stat-box h3,
            .award-card h3,
            .award-card h4,
            .testimonial-card h3,
            .testimonial-card h4,
            .future-feature-box h5 {
                color: #ffffff;
            }

            /* Mobilde metinlerin rahat okunması */
            @@media (max-width: 767px) {
                .section-title {
                    line-height: 1.2;
                }

                .text-muted,
                .text-white-50,
                .future-feature-box small,
                .custom-accordion .accordion-body {
                    font-size: 0.92rem;
                }
            }

    </style>
</head>