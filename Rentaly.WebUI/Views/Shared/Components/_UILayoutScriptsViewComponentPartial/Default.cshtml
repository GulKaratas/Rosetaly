<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- İnteraktif Filtreleme, Tarih Kilitleme & OCR Simülasyon Scripti -->
    <script>
            // Araç Kilitleme ve Rezervasyon Formu Aktarımı
            function lockAndBookCar(carName, price) {
                const selectedCar = document.getElementById('ocrSelectedCar');
                if (selectedCar) {
                    selectedCar.value = `${carName} (${price})`;
                }

                alert(`"${carName}" seçtiğiniz tarihler için kilitlendi!\nKimlik OCR veya hızlı form ekranına yönlendiriliyorsunuz.`);

                const modalElement = document.getElementById('ocrModal');
                if (!modalElement) {
                    return;
                }

                const ocrModal = new bootstrap.Modal(modalElement);
                ocrModal.show();
            }

            // Kimlik OCR Simülasyonu
            function simulateOcrScan() {
                const statusMsg = document.getElementById('ocrStatusMsg');
                statusMsg.style.display = 'block';
                statusMsg.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Kimlik yapay zeka ile taranıyor...';

                setTimeout(() => {
                    statusMsg.className = 'mt-3 p-2 rounded small text-center text-success';
                    statusMsg.style.background = 'rgba(30,203,21,0.15)';
                    statusMsg.innerHTML = '<i class="fa fa-check-circle me-1"></i> Kimlik başarıyla doğrulandı! Form dolduruldu.';

                    // Formu doldur
                    document.getElementById('ocrFullName').value = 'Ahmet Hakan Demir';
                    document.getElementById('ocrIdNumber').value = '28491028472';
                    document.getElementById('ocrBirthDate').value = '1992-06-15';
                    document.getElementById('ocrLicenseClass').value = 'B Sınıfı (8 Yıllık)';
                    document.getElementById('ocrPhone').value = '+90 532 458 92 14';
                }, 1200);
            }
    </script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const track = document.getElementById("carsListContainer");
        const prevBtn = document.getElementById("prevCarBtn");
        const nextBtn = document.getElementById("nextCarBtn");

        if (!track || !prevBtn || !nextBtn) return;

        let currentIndex = 0;

        function getVisibleCount() {
            if (window.innerWidth <= 575) return 1;
            if (window.innerWidth <= 991) return 2;
            return 3;
        }

        function getSlides() {
            return Array.from(track.querySelectorAll(".car-slide"));
        }

        function updateSlider() {
            const slides = getSlides();
            const visibleCount = getVisibleCount();
            const maxIndex = Math.max(0, slides.length - visibleCount);

            currentIndex = Math.min(currentIndex, maxIndex);

            if (slides.length > 0) {
                const gap = parseFloat(
                    getComputedStyle(track).columnGap
                ) || 0;

                const slideWidth =
                    slides[0].getBoundingClientRect().width;

                const offset = currentIndex * (slideWidth + gap);

                track.style.transform =
                    `translateX(-${offset}px)`;
            } else {
                track.style.transform = "translateX(0)";
            }

            // Sonsuz kaydırmada oklar hiçbir zaman kapanmaz.
            prevBtn.disabled = false;
            nextBtn.disabled = false;
        }

        nextBtn.addEventListener("click", function () {
            const slides = getSlides();
            const visibleCount = getVisibleCount();
            const maxIndex = Math.max(
                0,
                slides.length - visibleCount
            );

            if (currentIndex >= maxIndex) {
                // Son gruptan ilk gruba dön.
                currentIndex = 0;
            } else {
                currentIndex = Math.min(
                    currentIndex + visibleCount,
                    maxIndex
                );
            }

            updateSlider();
        });

        prevBtn.addEventListener("click", function () {
            const slides = getSlides();
            const visibleCount = getVisibleCount();
            const maxIndex = Math.max(
                0,
                slides.length - visibleCount
            );

            if (currentIndex <= 0) {
                // İlk gruptan son gruba dön.
                currentIndex = maxIndex;
            } else {
                currentIndex = Math.max(
                    currentIndex - visibleCount,
                    0
                );
            }

            updateSlider();
        });

        window.addEventListener("resize", updateSlider);

        updateSlider();
    });
</script>


