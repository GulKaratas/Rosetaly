@model CarListViewModel

@{
    ViewData["Title"] = "CarList";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .car-filters .item_filter_group {
        background: var(--dark-card);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 18px;
        color: #e5eaf1;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .car-filters .item_filter_group h4 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.05rem;
        margin-bottom: 14px;
        color: #fff;
    }

    .car-filters .form-check {
        margin-bottom: 8px;
        min-height: 1.4rem;
    }

    .car-filters .form-check-label {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #e5eaf1;
        font-size: 0.92rem;
        cursor: pointer;
    }

    .car-filters .form-check-input {
        background-color: #11141a;
        border-color: rgba(255, 255, 255, 0.25);
        cursor: pointer;
    }

    .car-filters .form-check-input:checked {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .car-filters .form-check-input:focus {
        box-shadow: 0 0 0 3px rgba(30, 203, 21, 0.2);
        border-color: var(--primary-color);
    }

    .car-filters .price-input {
        display: flex;
        gap: 12px;
        margin-bottom: 18px;
    }

    .car-filters .price-input .field {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        font-size: 0.85rem;
        color: #b8c2d0;
    }

    .car-filters .price-input .field input {
        width: 100%;
        background: #11141a;
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 6px 8px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 600;
        outline: none;
    }

    .car-filters .slider {
        height: 5px;
        position: relative;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 5px;
        margin: 8px 0 16px;
    }

    .car-filters .slider .progress {
        height: 100%;
        left: 0;
        right: 0;
        position: absolute;
        border-radius: 5px;
        background: var(--primary-color);
    }

    .car-filters .range-input {
        position: relative;
        height: 5px;
        margin-top: -21px;
        margin-bottom: 8px;
    }

    .car-filters .range-input input {
        position: absolute;
        width: 100%;
        height: 5px;
        top: 0;
        background: none;
        pointer-events: none;
        -webkit-appearance: none;
        appearance: none;
    }

    .car-filters .range-input input::-webkit-slider-thumb {
        height: 16px;
        width: 16px;
        border-radius: 50%;
        background: var(--primary-color);
        pointer-events: auto;
        -webkit-appearance: none;
        cursor: pointer;
    }

    .car-filters .range-input input::-moz-range-thumb {
        height: 16px;
        width: 16px;
        border: none;
        border-radius: 50%;
        background: var(--primary-color);
        pointer-events: auto;
        cursor: pointer;
    }

    .car-filters {
        scrollbar-width: thin;
        scrollbar-color: #2c3442 #0d0f13;
    }

    .car-filters::-webkit-scrollbar {
        width: 8px;
    }

    .car-filters::-webkit-scrollbar-track {
        background: #0d0f13;
        border-radius: 999px;
    }

    .car-filters::-webkit-scrollbar-thumb {
        background: #2c3442;
        border: 2px solid #0d0f13;
        border-radius: 999px;
    }

    .car-filters::-webkit-scrollbar-thumb:hover {
        background: #3d4758;
    }

    .car-thumb-link {
        display: block;
    }

        .car-thumb-link img {
            transition: transform 0.3s ease;
        }

        .car-thumb-link:hover img {
            transform: scale(1.04);
        }

    @@media (min-width: 992px) {
        .car-filters {
            position: sticky;
            top: 96px;
            max-height: calc(100vh - 112px);
            overflow-y: auto;
        }
    }
</style>

<section class="section-padding" id="section-cars" style="margin-top: 76px;">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-3">
            <div>
                <span class="section-subtitle">Filo</span>
                <h2 class="section-title mb-0">Araç Listesi</h2>
                <p class="text-white-50 mt-2 mb-0">
                    @if (Model.Pickup.HasValue && Model.ReturnDate.HasValue)
                    {
                        @: @Model.Pickup.Value.ToString("dd.MM.yyyy HH:mm") – @Model.ReturnDate.Value.ToString("dd.MM.yyyy HH:mm") aralığında müsait araçlar.
                    }
                    else
                    {
                        @: Müsait araçları inceleyin ve günlük fiyatla rezervasyon yapın.
                    }
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-success bg-opacity-25 text-success p-2">
                    @Model.Cars.Count Müsait
                </span>
            </div>
        </div>

        @if (Model.Cars.Count == 0)
        {
            <div class="car-card p-5 text-center">
                <i class="fa fa-car text-primary-custom fs-2 mb-3"></i>
                <h4 class="mb-2">Müsait araç yok</h4>
                <p class="mb-0">
                    @if (Model.Pickup.HasValue && Model.ReturnDate.HasValue)
                    {
                        @:Seçilen tarih aralığında müsait araç bulunamadı.
                    }
                    else
                    {
                        @:Filoya araç eklendiğinde burada görünecek.
                    }
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-3">
                    <div class="car-filters">
                        @if (Model.Brands.Count > 0)
                        {
                            <div class="item_filter_group">
                                <h4>Marka</h4>
                                @for (var i = 0; i < Model.Brands.Count; i++)
                                {
                                    var brandName = Model.Brands[i];
                                    <div class="form-check">
                                        <input class="form-check-input js-brand" id="brand-@i" type="checkbox" value="@brandName" />
                                        <label class="form-check-label" for="brand-@i">@brandName</label>
                                    </div>
                                }
                            </div>
                        }

                        @if (Model.Categories.Count > 0)
                        {
                            <div class="item_filter_group">
                                <h4>Kategori</h4>
                                @for (var i = 0; i < Model.Categories.Count; i++)
                                {
                                    var categoryName = Model.Categories[i];
                                    <div class="form-check">
                                        <input class="form-check-input js-category" id="category-@i" type="checkbox" value="@categoryName" />
                                        <label class="form-check-label" for="category-@i">@categoryName</label>
                                    </div>
                                }
                            </div>
                        }

                        @if (Model.SeatCounts.Count > 0)
                        {
                            <div class="item_filter_group">
                                <h4>Koltuk Sayısı</h4>
                                @foreach (var seatCount in Model.SeatCounts)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input js-seats" id="seat-@seatCount" type="checkbox" value="@seatCount" />
                                        <label class="form-check-label" for="seat-@seatCount">@seatCount Kişi</label>
                                    </div>
                                }
                            </div>
                        }

                        @if (Model.FuelTypes.Count > 0)
                        {
                            <div class="item_filter_group">
                                <h4>Yakıt</h4>
                                @for (var i = 0; i < Model.FuelTypes.Count; i++)
                                {
                                    var fuelType = Model.FuelTypes[i];
                                    <div class="form-check">
                                        <input class="form-check-input js-fuel" id="fuel-@i" type="checkbox" value="@fuelType" />
                                        <label class="form-check-label" for="fuel-@i">@fuelType</label>
                                    </div>
                                }
                            </div>
                        }

                        <div class="item_filter_group">
                            <h4>Günlük Fiyat (₺)</h4>
                            <div class="price-input">
                                <div class="field">
                                    <span>Min</span>
                                    <input type="number" class="input-min" value="0" min="0" />
                                </div>
                                <div class="field">
                                    <span>Max</span>
                                    <input type="number" class="input-max" value="0" min="0" />
                                </div>
                            </div>
                            <div class="slider">
                                <div class="progress"></div>
                            </div>
                            <div class="range-input">
                                <input type="range" class="range-min" min="0" value="0" step="50" />
                                <input type="range" class="range-max" min="0" value="0" step="50" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="row g-4" id="carGrid">
                        @foreach (var car in Model.Cars)
                        {
                            <div class="col-xl-4 col-lg-6 car-filter-item"
                                 data-brand="@car.BrandName"
                                 data-category="@car.CategoryName"
                                 data-seats="@car.SeatCount"
                                 data-fuel="@car.FuelType"
                                 data-price="@car.DailyPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <div class="car-card h-100 d-flex flex-column">
                                    <div class="car-thumb">
                                        <span class="car-badge">@car.CategoryName</span>

                                        <span class="car-status-available">
                                            <i class="fa fa-check"></i> Müsait
                                        </span>

                                        <a asp-controller="Car"
                                           asp-action="CarsDetails"
                                           asp-route-id="@car.CarId"
                                           class="car-thumb-link">
                                            <img alt="@car.BrandName @car.ModelName"
                                                 class="img-fluid"
                                                 src="@car.ImageUrl" />
                                        </a>
                                    </div>

                                    <div class="car-body d-flex flex-column flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h4 class="mb-1">@car.BrandName @car.ModelName</h4>
                                                <small class="text-white-50 mt-2 mb-0 d-block">
                                                    Model Yılı: @car.Year • @car.FuelType
                                                </small>
                                            </div>
                                            <span class="badge bg-dark text-warning">
                                                <i class="fa fa-star"></i> @car.Rating.ToString("0.0")
                                            </span>
                                        </div>

                                        <div class="car-specs-grid">
                                            <div class="car-spec-item">
                                                <i class="fa fa-user-group"></i> @car.SeatCount Kişi
                                            </div>
                                            <div class="car-spec-item">
                                                <i class="fa fa-suitcase"></i> @car.LuggageCount Bavul
                                            </div>
                                            <div class="car-spec-item">
                                                <i class="fa fa-cogs"></i> @car.Transmission
                                            </div>
                                            <div class="car-spec-item">
                                                <i class="fa fa-gauge"></i> @(car.PerformanceInfo ?? "Standart")
                                            </div>
                                        </div>

                                        <div class="car-price-row mt-auto">
                                            <div class="price-val">
                                                ₺@car.DailyPrice.ToString("N0")
                                                <span>/ Günlük</span>
                                            </div>

                                            <a asp-controller="Rental"
                                               asp-action="Index"
                                               asp-route-id="@car.CarId"
                                               class="btn btn-custom-primary btn-sm px-3">
                                                <i class="fa fa-lock"></i> Rezerve Et
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="car-card p-5 text-center d-none" id="carFilterEmpty">
                        <i class="fa fa-filter text-primary-custom fs-2 mb-3"></i>
                        <h4 class="mb-2">Bu filtrelere uygun araç yok</h4>
                        <p class="mb-0">Seçimleri gevşetin ya da fiyat aralığını genişletin.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<script>
    (function () {
        const minInput = document.querySelector('.car-filters .input-min');
        const maxInput = document.querySelector('.car-filters .input-max');
        const minRange = document.querySelector('.car-filters .range-min');
        const maxRange = document.querySelector('.car-filters .range-max');
        const progress = document.querySelector('.car-filters .slider .progress');
        const emptyBox = document.getElementById('carFilterEmpty');

        if (!minInput || !maxInput || !minRange || !maxRange || !progress || !emptyBox) {
            return;
        }

        const items = () => [...document.querySelectorAll('.car-filter-item')];
        const checkedValues = (selector) => [...document.querySelectorAll(selector + ':checked')].map(el => el.value.trim().toLowerCase());

        const prices = items().map(item => Number(item.dataset.price || 0));
        const highest = prices.length ? Math.ceil(Math.max(...prices)) : 0;
        const priceMax = Math.max(2000, Math.ceil(highest / 100) * 100);

        [minInput, maxInput, minRange, maxRange].forEach(function (input) {
            input.min = 0;
            input.max = priceMax;
        });
        minInput.value = 0;
        minRange.value = 0;
        maxInput.value = priceMax;
        maxRange.value = priceMax;

        function matchesAny(selected, actual) {
            return selected.length === 0 || selected.includes(actual);
        }

        function paintRange() {
            const maxLimit = Number(minRange.max) || 1;
            const minVal = Number(minRange.value);
            const maxVal = Number(maxRange.value);
            progress.style.left = (minVal / maxLimit) * 100 + '%';
            progress.style.right = (100 - (maxVal / maxLimit) * 100) + '%';
        }

        function applyFilters() {
            const brands = checkedValues('.js-brand');
            const categories = checkedValues('.js-category');
            const seats = checkedValues('.js-seats');
            const fuels = checkedValues('.js-fuel');
            const minPrice = Number(minInput.value || 0);
            const maxPrice = Number(maxInput.value || minRange.max);

            let visible = 0;
            items().forEach(item => {
                const brand = (item.dataset.brand || '').trim().toLowerCase();
                const category = (item.dataset.category || '').trim().toLowerCase();
                const seatCount = String(item.dataset.seats || '');
                const fuel = (item.dataset.fuel || '').trim().toLowerCase();
                const price = Number(item.dataset.price || 0);

                const brandOk = matchesAny(brands, brand);
                const categoryOk = matchesAny(categories, category);
                const seatOk = matchesAny(seats, seatCount);
                const fuelOk = matchesAny(fuels, fuel);
                const priceOk = price >= minPrice && price <= maxPrice;
                const show = brandOk && categoryOk && seatOk && fuelOk && priceOk;

                item.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            emptyBox.classList.toggle('d-none', visible !== 0);
        }

        document.querySelectorAll('.car-filters input[type="checkbox"]').forEach(input => {
            input.addEventListener('change', applyFilters);
        });

        minInput.addEventListener('input', function () {
            let minVal = Number(minInput.value || 0);
            const maxVal = Number(maxInput.value || 0);
            if (minVal > maxVal) minVal = maxVal;
            minInput.value = minVal;
            minRange.value = minVal;
            paintRange();
            applyFilters();
        });

        maxInput.addEventListener('input', function () {
            let maxVal = Number(maxInput.value || 0);
            const minVal = Number(minInput.value || 0);
            const limit = Number(maxRange.max);
            if (maxVal < minVal) maxVal = minVal;
            if (maxVal > limit) maxVal = limit;
            maxInput.value = maxVal;
            maxRange.value = maxVal;
            paintRange();
            applyFilters();
        });

        minRange.addEventListener('input', function () {
            let minVal = Number(minRange.value);
            const maxVal = Number(maxRange.value);
            if (minVal > maxVal) {
                minVal = maxVal;
                minRange.value = minVal;
            }
            minInput.value = minVal;
            paintRange();
            applyFilters();
        });

        maxRange.addEventListener('input', function () {
            let maxVal = Number(maxRange.value);
            const minVal = Number(minRange.value);
            if (maxVal < minVal) {
                maxVal = minVal;
                maxRange.value = maxVal;
            }
            maxInput.value = maxVal;
            paintRange();
            applyFilters();
        });

        paintRange();
    })();
</script>
