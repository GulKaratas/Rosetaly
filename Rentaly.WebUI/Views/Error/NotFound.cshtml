@{
    Layout = "~/Views/Shared/_UILayout.cshtml";
    ViewData["Title"] = "Sayfa Bulunamadı - 404";
}

<div id="wrapper">
    <!-- content begin -->
    <div class="no-bottom no-top" id="content">
        <div id="top"></div>
        <section id="section-hero" class="section-padding vertical-center min-vh-100 d-flex align-items-center" style="background-color: #0d0f13; position: relative;">
            <div class="container">
                <div class="row align-items-center justify-content-center text-center text-lg-start">

                    <!-- Sol Metin Alanı -->
                    <div class="col-lg-6 mb-5 mb-lg-0">
                        <span class="section-subtitle">HATA 404</span>
                        <h1 class="display-4 font-heading text-white fw-bold mb-3">Aradığınız Sayfa Bulunamadı.</h1>
                        <p class="text-muted fs-5 mb-4 font-body">
                            Gitmek istediğiniz sayfa kaldırılmış, adı değiştirilmiş veya geçici olarak kullanılamıyor olabilir. Ana sayfaya dönerek işlemlerinize devam edebilirsiniz.
                        </p>
                        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                            <a asp-controller="Default" asp-action="Index" class="btn btn-custom-primary">
                                <i class="fa-solid fa-house"></i> Ana Sayfaya Dön
                            </a>
                        </div>
                    </div>

                    <!-- Sağ Büyük 404 Görsel / Tipografi Alanı -->
                    <div class="col-lg-6 text-center">
                        <div class="stat-box p-5 border border-secondary border-opacity-25 rounded-4" style="background: linear-gradient(145deg, #181d24, #11141a);">
                            <h1 class="display-1 fw-black text-primary-custom mb-0 font-heading" style="font-size: 7rem; letter-spacing: -3px; color: var(--primary-color);">
                                404
                            </h1>
                            <div class="spacer-single my-2"></div>
                            <h4 class="text-white fw-bold">Sayfa Bulunamadı</h4>
                            <p class="text-muted small mb-0">Rentaly Güvenli Navigasyon Sistemi</p>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </div>
    <!-- content close -->
</div>